From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Domenico D'Arrigo <DCHEM88@hotmail.it>
Date: Sat, 10 Oct 2026 21:32:39 +0200
Subject: [PATCH] payloads/external/edk2: Pass
 PcdCapsuleOnDiskConnectBootDevice where it exists

DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT sets the PCD for every edk2 tree,
but the tree of MrChromebox, the default one, doesn't declare it, and
the edk2 build stops:

  error F000: The Pcd gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleOnDiskConnectBootDevice
  is not found in the DEC file.

Pass it only when MdeModulePkg.dec declares it, checked when the build
runs, after the tree is checked out.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 payloads/external/edk2/Makefile | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/payloads/external/edk2/Makefile b/payloads/external/edk2/Makefile
index 75b7f7983..29fa450ae 100644
--- a/payloads/external/edk2/Makefile
+++ b/payloads/external/edk2/Makefile
@@ -147,7 +147,9 @@ BUILD_STR += --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleEmbeddedDriverSuppor
 endif
 ifeq ($(CONFIG_DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT),y)
 BUILD_STR += --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleOnDiskSupport=TRUE
-BUILD_STR += --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleOnDiskConnectBootDevice=TRUE
+# Only for trees that declare it: build stops at a PCD missing from the DEC files
+BUILD_STR += $$(grep -qs PcdCapsuleOnDiskConnectBootDevice $(EDK2_PATH)/MdeModulePkg/MdeModulePkg.dec && \
+	echo --pcd gEfiMdeModulePkgTokenSpaceGuid.PcdCapsuleOnDiskConnectBootDevice=TRUE)
 endif
 ifeq ($(CONFIG_DRIVERS_EFI_CAPSULE_EMBED_FMP_DXE),y)
 BUILD_STR += -D CAPSULE_EMBED_FMP_DXE=TRUE
-- 
