   device is locked, any attempts to modify the firmware image contents in the
@@ -2300,5 +2385,6 @@ FmpDeviceSmmLibConstructor (
   )
 {
   SmmStoreLibInitialize ();
+  FmpStatusInstall ();
   return EFI_SUCCESS;
 }
