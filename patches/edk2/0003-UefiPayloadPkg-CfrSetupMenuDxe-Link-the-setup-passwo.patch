 STATIC UINTN                mQuestionIdMapCount = 0;
 STATIC UINTN                mQuestionIdMapSize  = 0;
 
+//
+// Formset of UserAuthenticationDxe (USER_AUTHENTICATION_FORMSET_GUID) and
+// its form, which sets the password asked for before the setup menu opens.
+//
+STATIC CONST EFI_GUID  mUserAuthenticationFormsetGuid = {
+  0x760e3022, 0xf149, 0x4560, { 0x9c, 0x6f, 0x33, 0xaa, 0x7d, 0x48, 0x75, 0xfa }
+};
+
+#define USER_AUTHENTICATION_FORM_ID  0x0001
+
 //
 // Titles of the category forms, set from the top-level CFR forms
 //
@@ -1336,13 +1347,79 @@ CfrAllocateLabeledOpCodeHandle (
   return OpCodeHandle;
 }
 
+/**
+  Return whether a category gets the link to the password of the setup
+  menu: its title is PcdCfrSetupMenuPasswordCategory.
+
+  @param[in]  Title  Title of the category.
+
+  @retval TRUE   The category ends with the link.
+  @retval FALSE  It does not.
+
+**/
+STATIC
+BOOLEAN
+CfrIsPasswordCategory (
+  IN CONST CHAR16  *Title
+  )
+{
+  CONST CHAR16  *Category;
+
+  Category = (CONST CHAR16 *)PcdGetPtr (PcdCfrSetupMenuPasswordCategory);
+  return (BOOLEAN)((Title != NULL) && (Category != NULL) && (Category[0] != L'\0') &&
+                   (StrCmp (Title, Category) == 0));
+}
+
+/**
+  Append a card with a link to the password asked for before the setup menu
+  opens: the form of UserAuthenticationDxe, which asks for the current and
+  the new password. When that driver is missing, the browser reports
+  nothing: after the usual prompt about unsaved changes, if any, selecting
+  the link just leaves this formset.
+
+  @param[in]  OpCodeHandle  Handle of the category form.
+
+**/
+STATIC
+VOID
+CfrAddPasswordLink (
+  IN VOID  *OpCodeHandle
+  )
+{
+  UINT8  *TempHiiBuffer;
+
+  TempHiiBuffer = HiiCreateSubTitleOpCode (
+                    OpCodeHandle,
+                    STRING_TOKEN (STR_PASSWORD_TITLE),
+                    0,
+                    0,
+                    0
+                    );
+  ASSERT (TempHiiBuffer != NULL);
+
+  TempHiiBuffer = HiiCreateGotoExOpCode (
+                    OpCodeHandle,
+                    USER_AUTHENTICATION_FORM_ID,
+                    STRING_TOKEN (STR_PASSWORD_PROMPT),
+                    STRING_TOKEN (STR_PASSWORD_HELP),
+                    0,
+                    SETUP_MENU_PASSWORD_QUESTION_ID,
+                    0,
+                    (EFI_GUID *)&mUserAuthenticationFormsetGuid,
+                    0
+                    );
+  ASSERT (TempHiiBuffer != NULL);
+}
+
 /**
   Create runtime components by iterating CFR forms.
 
   Each top-level CFR form, up to SETUP_MENU_CATEGORY_MAX, fills a category
   form of its own, and the main form links to it. A form that is suppressed
   or comes after those stays in the main form, under a subtitle, as before.
-  Nested forms become subtitles in the form of their parent.
+  Nested forms become subtitles in the form of their parent. The category
+  named by PcdCfrSetupMenuPasswordCategory ends with a link to the password
+  of the setup menu.
 
 **/
 VOID
@@ -1406,14 +1483,19 @@ CfrCreateRuntimeComponents (
       DEBUG ((DEBUG_INFO, "CFR: Category %u: \"%a\"\n", (UINT32)Category, CfrFormName->data));
 
       //
-      // The category form: its title and its options
+      // The category form: its title and its options, and the password of
+      // the setup menu at the end of the category that gets it
       //
       CfrConvertVarBinaryToStrings (CfrFormName, &FormName, NULL);
       HiiSetString (mSetupMenuPrivate.HiiHandle, mCategoryTitle[Category], FormName, NULL);
-      FreePool (FormName);
 
       FormOpCodeHandle = CfrAllocateLabeledOpCodeHandle (LABEL_RT_COMP_START);
       CfrProcessFormChildren (CfrFormHob, CfrFormChildrenOffset (CfrFormHob), FormOpCodeHandle);
+      if (CfrIsPasswordCategory (FormName)) {
+        CfrAddPasswordLink (FormOpCodeHandle);
+      }
+
+      FreePool (FormName);
       Status = HiiUpdateForm (
                  mSetupMenuPrivate.HiiHandle,
                  &mSetupMenuFormsetGuid,
