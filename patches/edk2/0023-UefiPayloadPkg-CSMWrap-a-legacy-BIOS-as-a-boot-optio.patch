From: Domenico D'Arrigo <DCHEM88@hotmail.it>
Date: Fri, 16 Oct 2026 10:52:17 +0200
Subject: [PATCH] UefiPayloadPkg: CSMWrap, a legacy BIOS, as a boot option

CSMWrap (https://github.com/CSMWrap/CSMWrap) boots legacy BIOS software
on a UEFI-only firmware with the CSM and the VGA BIOS of SeaBIOS: INT 10h,
INT 13h and the other services, E820 from the UEFI memory map, ACPI and
SMBIOS passed through. Built separately and put in the firmware volume
with -D CSMWRAP=TRUE (UefiPayloadPkg/LegacyBoot/csmwrap.efi, as iPXE is
with NETWORK_IPXE), PlatformBootManagerLib registers it as a boot
option, PcdCsmWrapOptionName, from PcdCsmWrapFile.

A legacy BIOS runs unsigned code, so the option exists only while Secure
Boot is off: with the SecureBoot variable at 1 the boot manager deletes
it, as it does when the "csmwrap_boot" switch of the coreboot setup menu
is off.

Co-authored-by: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 .../PlatformBootManager.c                     | 41 +++++++++++++++++++
 .../PlatformBootManager.h                     |  2 +
 .../PlatformBootManagerLib.inf                |  5 ++-
 UefiPayloadPkg/UefiPayloadPkg.dec             |  4 ++
 UefiPayloadPkg/UefiPayloadPkg.dsc             |  7 ++++
 UefiPayloadPkg/UefiPayloadPkg.fdf             | 10 +++++
 6 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
index 6ec0d73b9..eb220efd0 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.c
@@ -289,6 +289,29 @@ PlatformSetupSwitch (
   return Value != 0;
 }
 
+/**
+  Is Secure Boot on? The SecureBoot variable, as the image verification
+  sets it: 1 with the keys enrolled and user mode.
+
+  @retval TRUE   On.
+  @retval FALSE  Off, or no such variable.
+**/
+STATIC
+BOOLEAN
+PlatformSecureBootOn (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINT8       SecureBoot;
+  UINTN       Size;
+
+  SecureBoot = 0;
+  Size       = sizeof (SecureBoot);
+  Status     = gRT->GetVariable (EFI_SECURE_BOOT_MODE_NAME, &gEfiGlobalVariableGuid, NULL, &Size, &SecureBoot);
+  return !EFI_ERROR (Status) && (SecureBoot == SECURE_BOOT_MODE_ENABLE);
+}
+
 EFI_HANDLE BootManagerEntryNotifyHandle1;
 EFI_HANDLE BootManagerEntryNotifyHandle2;
 EFI_HANDLE BootManagerContinueNotifyHandle;
@@ -573,6 +596,24 @@ PlatformBootManagerAfterConsole (
     }
   }
 
+  //
+  // Register CSMWrap, the legacy BIOS, if the binary is present in the
+  // firmware volume, Secure Boot is off (a legacy BIOS runs unsigned code)
+  // and the setup has not turned it off (csmwrap_boot); otherwise the
+  // option goes.
+  //
+  if ((PcdGetPtr (PcdCsmWrapFile) != NULL) && (PcdGetPtr (PcdCsmWrapOptionName) != NULL)) {
+    if (!PlatformSecureBootOn () && PlatformSetupSwitch (L"csmwrap_boot")) {
+      PlatformRegisterFvBootOption (
+        (EFI_GUID *)PcdGetPtr (PcdCsmWrapFile),
+        (CHAR16 *)PcdGetPtr (PcdCsmWrapOptionName),
+        LOAD_OPTION_ACTIVE
+        );
+    } else {
+      PlatformRemoveFvBootOption ((EFI_GUID *)PcdGetPtr (PcdCsmWrapFile));
+    }
+  }
+
   if (FixedPcdGetBool (PcdBootManagerEscape)) {
     if (FixedPcdGetBool (PcdSerialTerminalPrintEnabled)) {
       Print (
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
index 137a8831b..81d38e770 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManager.h
@@ -30,6 +30,8 @@ SPDX-License-Identifier: BSD-2-Clause-Patent
 #include <Library/TcgPhysicalPresenceLib.h>
 #include <Library/Tcg2PhysicalPresenceLib.h>
 #include <Protocol/SmmAccess2.h>
+#include <Guid/GlobalVariable.h>
+#include <Guid/ImageAuthentication.h>
 
 typedef struct {
   EFI_DEVICE_PATH_PROTOCOL    *DevicePath;
diff --git a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
index e322a95d4..d350c1aaf 100644
--- a/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
+++ b/UefiPayloadPkg/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
@@ -66,7 +66,8 @@
   gEfiCapsuleReportGuid           ## CONSUMES ## Variable:L"CapsuleLast"
   gEfiFileInfoGuid                ## CONSUMES
   gEfiPartTypeSystemPartGuid      ## CONSUMES
-  gEficorebootNvDataGuid          ## CONSUMES ## Variable:L"ipxe_boot"
+  gEficorebootNvDataGuid          ## CONSUMES ## Variable:L"ipxe_boot" L"csmwrap_boot"
+  gEfiGlobalVariableGuid          ## CONSUMES ## Variable:L"SecureBoot"
 
 [Protocols]
   gEfiGenericMemTestProtocolGuid  ## CONSUMES
@@ -96,3 +97,5 @@
   gUefiPayloadPkgTokenSpaceGuid.PcdSerialTerminalPrintEnabled
   gUefiPayloadPkgTokenSpaceGuid.PcdiPXEFile
   gUefiPayloadPkgTokenSpaceGuid.PcdiPXEOptionName
+  gUefiPayloadPkgTokenSpaceGuid.PcdCsmWrapFile
+  gUefiPayloadPkgTokenSpaceGuid.PcdCsmWrapOptionName
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dec b/UefiPayloadPkg/UefiPayloadPkg.dec
index b04fc1fd4..ff3eb359d 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dec
+++ b/UefiPayloadPkg/UefiPayloadPkg.dec
@@ -117,6 +117,10 @@ gUefiPayloadPkgTokenSpaceGuid.PcdBootloaderParameter|0|UINT64|0x10000004
 gUefiPayloadPkgTokenSpaceGuid.PcdiPXEFile|{ 0xC7, 0x53, 0x86, 0xB6, 0xA1, 0xEE, 0x35, 0x44, 0xA1, 0x99, 0xA4, 0x4F, 0x59, 0xE4, 0x47, 0x6C }|VOID*|0x10000032
 gUefiPayloadPkgTokenSpaceGuid.PcdiPXEOptionName|L"iPXE Network Boot"|VOID*|0x10000033
 
+## FFS filename to find the CSMWrap application (legacy BIOS boot).
+gUefiPayloadPkgTokenSpaceGuid.PcdCsmWrapFile|{ 0x4A, 0xB2, 0x0E, 0x93, 0xA7, 0x08, 0x84, 0x4D, 0xA9, 0x86, 0x7E, 0x91, 0x3F, 0x40, 0x52, 0x70 }|VOID*|0x10000034
+gUefiPayloadPkgTokenSpaceGuid.PcdCsmWrapOptionName|L"CSMWrap Legacy Boot"|VOID*|0x10000035
+
 ## Used to help reduce fragmentation in the EFI memory map
 gUefiPayloadPkgTokenSpaceGuid.PcdMemoryTypeEfiACPIReclaimMemory|0x19|UINT32|0x10000012
 gUefiPayloadPkgTokenSpaceGuid.PcdMemoryTypeEfiACPIMemoryNVS|0x04|UINT32|0x10000013
diff --git a/UefiPayloadPkg/UefiPayloadPkg.dsc b/UefiPayloadPkg/UefiPayloadPkg.dsc
index 999a0938d..99579f438 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.dsc
+++ b/UefiPayloadPkg/UefiPayloadPkg.dsc
@@ -207,6 +207,13 @@
   DEFINE NETWORK_SNP_ENABLE             = FALSE
   DEFINE NETWORK_IPXE                   = FALSE
 
+  #
+  # CSMWrap, a legacy BIOS (the CSM and VGA BIOS of SeaBIOS) as a boot
+  # option, for the operating systems and tools that do not boot from UEFI.
+  # The application is built separately: UefiPayloadPkg/LegacyBoot/csmwrap.efi
+  #
+  DEFINE CSMWRAP                        = FALSE
+
 !if $(NETWORK_PXE_BOOT) == TRUE
   DEFINE NETWORK_ENABLE                 = TRUE
   DEFINE NETWORK_DRIVER_ENABLE          = TRUE
diff --git a/UefiPayloadPkg/UefiPayloadPkg.fdf b/UefiPayloadPkg/UefiPayloadPkg.fdf
index c1ce2cb8d..55e5ce139 100644
--- a/UefiPayloadPkg/UefiPayloadPkg.fdf
+++ b/UefiPayloadPkg/UefiPayloadPkg.fdf
@@ -511,6 +511,16 @@ INF MdeModulePkg/Application/BootManagerMenuApp/BootManagerMenuApp.inf
   }
 !endif
 
+#
+# CSMWrap: a legacy BIOS as a boot option of PlatformBootManagerLib
+# (PcdCsmWrapFile), shown while Secure Boot is off
+#
+!if $(CSMWRAP) == TRUE
+  FILE FREEFORM = 930EB24A-08A7-4D84-A986-7E913F405270 {
+    SECTION PE32 = UefiPayloadPkg/LegacyBoot/csmwrap.efi
+  }
+!endif
+
