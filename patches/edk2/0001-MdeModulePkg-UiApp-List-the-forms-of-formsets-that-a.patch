+/**
+  Whether a formset has ClassGuid among its class GUIDs.
+
+  @param    FormSet             The formset opcode.
+  @param    ClassGuid           The class guid to look for.
+
+  @retval   TRUE                It does.
+  @retval   FALSE               It does not.
+
+**/
+STATIC
+BOOLEAN
+FormSetHasClassGuid (
+  IN EFI_IFR_FORM_SET  *FormSet,
+  IN EFI_GUID          *ClassGuid
+  )
+{
+  UINT8     ClassGuidNum;
+  EFI_GUID  *Guid;
+
+  if (FormSet->Header.Length <= OFFSET_OF (EFI_IFR_FORM_SET, Flags)) {
+    return FALSE;
+  }
+
+  ClassGuidNum = (UINT8)(FormSet->Flags & 0x3);
+  Guid         = (EFI_GUID *)(VOID *)((UINT8 *)FormSet + sizeof (EFI_IFR_FORM_SET));
+  while (ClassGuidNum-- > 0) {
+    if (CompareGuid (ClassGuid, Guid)) {
+      return TRUE;
+    }
+
+    Guid++;
+  }
+
+  return FALSE;
+}
+
+/**
+  Add a front page entry for each form, except the first one, of the formsets
+  that have ClassGuid among their class GUIDs, for example the categories of a
+  setup menu. Forms with an empty title are left out.
+
+  @param    HiiHandle           The hii handle for the Uiapp driver.
+  @param    ClassGuid           The class guid of the formsets.
+  @param    StartOpCodeHandle   The opcode handle to save the new opcode.
+
+  @return   The number of entries added.
+
+**/
+UINTN
+UiListFormsetForms (
+  IN EFI_HII_HANDLE  HiiHandle,
+  IN EFI_GUID        *ClassGuid,
+  IN VOID            *StartOpCodeHandle
+  )
+{
+  EFI_HII_HANDLE               *HiiHandles;
+  UINTN                        Index;
+  EFI_STATUS                   Status;
+  EFI_STRING_ID                Token;
+  EFI_STRING_ID                TokenHelp;
+  EFI_GUID                     FormSetGuid;
+  UINTN                        PackageListSize;
+  EFI_HII_PACKAGE_LIST_HEADER  *PackageList;
+  UINT32                       PackageListLength;
+  UINT32                       Offset;
+  UINT32                       Offset2;
+  UINT8                        *Package;
+  EFI_HII_PACKAGE_HEADER       PackageHeader;
+  EFI_IFR_OP_HEADER            *OpCode;
+  EFI_IFR_FORM                 *Form;
+  BOOLEAN                      FirstForm;
+  BOOLEAN                      ListForms;
+  EFI_STRING                   String;
+  EFI_STRING_ID                PromptId;
+  EFI_STRING_ID                DevicePathId;
+  CHAR16                       *DevicePathStr;
+  UINTN                        Count;
+
+  HiiHandles = HiiGetHiiHandles (NULL);
+  if (HiiHandles == NULL) {
+    return 0;
+  }
+
+  Count = 0;
+  for (Index = 0; HiiHandles[Index] != NULL; Index++) {
+    if (!RequiredDriver (HiiHandles[Index], ClassGuid, &Token, &TokenHelp, &FormSetGuid)) {
+      continue;
+    }
+
+    PackageListSize = 0;
+    Status          = gHiiDatabase->ExportPackageLists (gHiiDatabase, HiiHandles[Index], &PackageListSize, NULL);
+    if (Status != EFI_BUFFER_TOO_SMALL) {
+      continue;
+    }
+
+    PackageList = AllocatePool (PackageListSize);
+    if (PackageList == NULL) {
+      continue;
+    }
+
+    Status = gHiiDatabase->ExportPackageLists (gHiiDatabase, HiiHandles[Index], &PackageListSize, PackageList);
+    if (EFI_ERROR (Status)) {
+      FreePool (PackageList);
+      continue;
+    }
+
+    DevicePathId  = 0;
+    DevicePathStr = ExtractDevicePathFromHiiHandle (HiiHandles[Index]);
+    if (DevicePathStr != NULL) {
+      DevicePathId = HiiSetString (HiiHandle, 0, DevicePathStr, NULL);
+      FreePool (DevicePathStr);
+    }
+
+    //
+    // Every form opcode of the formsets that ask for it, but the first form
+    // of each
+    //
+    FirstForm         = TRUE;
+    ListForms         = FALSE;
+    Offset            = sizeof (EFI_HII_PACKAGE_LIST_HEADER);
+    PackageListLength = ReadUnaligned32 (&PackageList->PackageLength);
+    while (Offset < PackageListLength) {
+      Package = (UINT8 *)PackageList + Offset;
+      CopyMem (&PackageHeader, Package, sizeof (EFI_HII_PACKAGE_HEADER));
+      if (PackageHeader.Length == 0) {
+        break;
+      }
+
+      Offset += PackageHeader.Length;
+      if (PackageHeader.Type != EFI_HII_PACKAGE_FORMS) {
+        continue;
+      }
+
+      Offset2 = sizeof (EFI_HII_PACKAGE_HEADER);
+      while (Offset2 < PackageHeader.Length) {
+        OpCode = (EFI_IFR_OP_HEADER *)(Package + Offset2);
+        if (OpCode->Length == 0) {
+          break;
+        }
+
+        Offset2 += OpCode->Length;
+        if (OpCode->OpCode == EFI_IFR_FORM_SET_OP) {
+          //
+          // The forms that follow are of this formset: entries point to it
+          //
+          ListForms = FormSetHasClassGuid ((EFI_IFR_FORM_SET *)OpCode, ClassGuid);
+          if (ListForms) {
+            CopyMem (&FormSetGuid, &((EFI_IFR_FORM_SET *)OpCode)->Guid, sizeof (EFI_GUID));
+            FirstForm = TRUE;
+          }
+
+          continue;
+        }
+
+        if ((OpCode->OpCode != EFI_IFR_FORM_OP) || !ListForms) {
+          continue;
+        }
+
+        if (FirstForm) {
+          FirstForm = FALSE;
+          continue;
+        }
+
+        Form   = (EFI_IFR_FORM *)OpCode;
+        String = HiiGetString (HiiHandles[Index], Form->FormTitle, NULL);
+        if ((String == NULL) || (*String == L'\0')) {
+          if (String != NULL) {
+            FreePool (String);
+          }
+
+          continue;
+        }
+
+        PromptId = HiiSetString (HiiHandle, 0, String, NULL);
+        FreePool (String);
+
+        HiiCreateGotoExOpCode (
+          StartOpCodeHandle,
+          Form->FormId,
+          PromptId,
+          STRING_TOKEN (STR_EMPTY_STRING),
+          0,
+          (EFI_QUESTION_ID)(Count + FRONT_PAGE_KEY_FORM),
+          0,
+          &FormSetGuid,
+          DevicePathId
+          );
+        Count++;
+      }
+    }
+
+    FreePool (PackageList);
+  }
+
+  FreePool (HiiHandles);
+
+  return Count;
+}
