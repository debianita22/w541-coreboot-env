diff --git a/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.c b/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.c
new file mode 100644
index 0000000000..fdffa1f2da
--- /dev/null
+++ b/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.c
@@ -0,0 +1,169 @@
+/** @file
+  vboot A/B updates for SMMSTORE-backed firmware updates.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Library/BaseLib.h>
+#include <Library/BaseMemoryLib.h>
+
+#include "FmpDeviceSmmVboot.h"
+
+/**
+  Whether a manifest entry names Name.
+**/
+STATIC
+BOOLEAN
+EntryIs (
+  IN CONST REGION_MANIFEST_ENTRY  *Entry,
+  IN CONST CHAR8                  *Name
+  )
+{
+  CHAR8  Padded[REGION_MANIFEST_NAME_LEN];
+
+  ZeroMem (Padded, sizeof (Padded));
+  CopyMem (Padded, Name, AsciiStrLen (Name));
+  return CompareMem (Entry->RegionName, Padded, sizeof (Padded)) == 0;
+}
+
+BOOLEAN
+FmpVbootFindSlots (
+  IN  CONST REGION_MANIFEST_ENTRY  *Entries,
+  IN  UINTN                        Count,
+  OUT UINTN                        *IndexA,
+  OUT UINTN                        *IndexB
+  )
+{
+  UINTN  Index;
+  UINTN  FoundA;
+  UINTN  FoundB;
+
+  if (Entries == NULL) {
+    return FALSE;
+  }
+
+  FoundA = 0;
+  FoundB = 0;
+  for (Index = 0; Index < Count; Index++) {
+    if (EntryIs (&Entries[Index], "RW_SECTION_A")) {
+      *IndexA = Index;
+      FoundA++;
+    } else if (EntryIs (&Entries[Index], "RW_SECTION_B")) {
+      *IndexB = Index;
+      FoundB++;
+    }
+  }
+
+  return (FoundA == 1) && (FoundB == 1);
+}
+
+UINT8
+FmpVbootNvCrc8 (
+  IN CONST UINT8  *Data,
+  IN UINTN        Size
+  )
+{
+  UINT32  Crc;
+  UINTN   Index;
+  UINTN   Bit;
+
+  Crc = 0;
+  for (Index = 0; Index < Size; Index++) {
+    Crc ^= ((UINT32)Data[Index] << 8);
+    for (Bit = 0; Bit < 8; Bit++) {
+      if ((Crc & 0x8000) != 0) {
+        Crc ^= (0x1070 << 3);
+      }
+
+      Crc <<= 1;
+    }
+  }
+
+  return (UINT8)(Crc >> 8);
+}
+
+/**
+  Whether a record is erased flash.
+**/
+STATIC
+BOOLEAN
+RecordIsErased (
+  IN CONST UINT8  *Record
+  )
+{
+  UINTN  Index;
+
+  for (Index = 0; Index < VBOOT_NV_RECORD_SIZE; Index++) {
+    if (Record[Index] != 0xFF) {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
+
+BOOLEAN
+FmpVbootNvFindCurrent (
+  IN  CONST UINT8  *Region,
+  IN  UINTN        Size,
+  OUT UINT8        Record[VBOOT_NV_RECORD_SIZE],
+  OUT UINTN        *NextOffset
+  )
+{
+  UINTN  Offset;
+
+  //
+  // Records are appended from the start of the region, and the region is
+  // erased when it is full: the current one is the last before the first
+  // erased one.
+  //
+  for (Offset = 0; Offset + VBOOT_NV_RECORD_SIZE <= Size; Offset += VBOOT_NV_RECORD_SIZE) {
+    if (RecordIsErased (Region + Offset)) {
+      break;
+    }
+  }
+
+  *NextOffset = (Offset + VBOOT_NV_RECORD_SIZE <= Size) ? Offset : Size;
+  if ((Offset > 0) &&
+      ((Region[Offset - VBOOT_NV_RECORD_SIZE + VBOOT_NV_OFFS_HEADER] & VBOOT_NV_HEADER_MASK) == VBOOT_NV_HEADER_SIGNATURE) &&
+      (FmpVbootNvCrc8 (Region + Offset - VBOOT_NV_RECORD_SIZE, VBOOT_NV_OFFS_CRC) ==
+       Region[Offset - VBOOT_NV_RECORD_SIZE + VBOOT_NV_OFFS_CRC]))
+  {
+    CopyMem (Record, Region + Offset - VBOOT_NV_RECORD_SIZE, VBOOT_NV_RECORD_SIZE);
+    return TRUE;
+  }
+
+  //
+  // What vboot starts from without valid nvdata: slot A, nothing to try.
+  //
+  ZeroMem (Record, VBOOT_NV_RECORD_SIZE);
+  Record[VBOOT_NV_OFFS_HEADER] = VBOOT_NV_HEADER_SIGNATURE;
+  Record[VBOOT_NV_OFFS_CRC]    = FmpVbootNvCrc8 (Record, VBOOT_NV_OFFS_CRC);
+  return FALSE;
+}
+
+UINTN
+FmpVbootNvTriedSlot (
+  IN CONST UINT8  Record[VBOOT_NV_RECORD_SIZE]
+  )
+{
+  return ((Record[VBOOT_NV_OFFS_BOOT2] & VBOOT_NV_BOOT2_TRIED) != 0) ? 1 : 0;
+}
+
+VOID
+FmpVbootNvSetTryNext (
+  IN OUT UINT8  Record[VBOOT_NV_RECORD_SIZE],
+  IN     UINTN  Slot,
+  IN     UINT8  Tries
+  )
+{
+  if (Slot != 0) {
+    Record[VBOOT_NV_OFFS_BOOT2] |= VBOOT_NV_BOOT2_TRY_NEXT;
+  } else {
+    Record[VBOOT_NV_OFFS_BOOT2] &= (UINT8) ~VBOOT_NV_BOOT2_TRY_NEXT;
+  }
+
+  Record[VBOOT_NV_OFFS_BOOT] &= (UINT8) ~VBOOT_NV_BOOT_TRY_COUNT;
+  Record[VBOOT_NV_OFFS_BOOT] |= (Tries & VBOOT_NV_BOOT_TRY_COUNT);
+  Record[VBOOT_NV_OFFS_CRC]   = FmpVbootNvCrc8 (Record, VBOOT_NV_OFFS_CRC);
+}
diff --git a/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.h b/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.h
new file mode 100644
index 0000000000..d480fe5c15
--- /dev/null
+++ b/UefiPayloadPkg/Library/FmpDeviceSmmLib/FmpDeviceSmmVboot.h
@@ -0,0 +1,107 @@
+/** @file
+  vboot A/B updates for SMMSTORE-backed firmware updates.
+
+  A firmware verified by vboot with two RW slots (RW_SECTION_A and
+  RW_SECTION_B in the FMAP) and its nvdata in flash (RW_NVRAM, the format of
+  coreboot's vbnv_flash.c: 16-byte V1 records appended until the region is
+  full) is updated one slot at a time: the slot that is not running is
+  written, then vboot is asked to try it on the next boots.  If the write is
+  cut short, or the new slot does not verify, vboot boots the old one.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#pragma once
+
+#include <Base.h>
+#include "FmpDeviceSmmManifest.h"
+
+#define VBOOT_NV_RECORD_SIZE  16
+
+//
+// Fields of a V1 record (vboot_reference, 2nvstorage_fields.h).
+//
+#define VBOOT_NV_OFFS_HEADER         0
+#define VBOOT_NV_OFFS_BOOT           1
+#define VBOOT_NV_OFFS_BOOT2          7
+#define VBOOT_NV_OFFS_CRC            15
+#define VBOOT_NV_HEADER_SIGNATURE    0x40
+#define VBOOT_NV_HEADER_MASK         0xC0
+#define VBOOT_NV_BOOT_TRY_COUNT      0x0F
+#define VBOOT_NV_BOOT2_RESULT        0x03
+#define VBOOT_NV_BOOT2_TRIED         0x04
+#define VBOOT_NV_BOOT2_TRY_NEXT      0x08
+
+//
+// Boots vboot gives a new slot before it falls back to the other one, if
+// the payload of the new slot never reports that it booted.
+//
+#define VBOOT_AB_TRY_COUNT  2
+
+/**
+  Whether a manifest names the two RW slots of vboot, each once; it may name
+  other regions too.
+
+  @param[in]  Entries  Manifest entries.
+  @param[in]  Count    Number of entries.
+  @param[out] IndexA   Entry of RW_SECTION_A.
+  @param[out] IndexB   Entry of RW_SECTION_B.
+
+  @retval TRUE   The manifest has RW_SECTION_A and RW_SECTION_B.
+  @retval FALSE  It does not.
+**/
+BOOLEAN
+FmpVbootFindSlots (
+  IN  CONST REGION_MANIFEST_ENTRY  *Entries,
+  IN  UINTN                        Count,
+  OUT UINTN                        *IndexA,
+  OUT UINTN                        *IndexB
+  );
+
+/**
+  CRC-8 of a V1 record, as vboot computes it (x^8 + x^2 + x + 1).
+**/
+UINT8
+FmpVbootNvCrc8 (
+  IN CONST UINT8  *Data,
+  IN UINTN        Size
+  );
+
+/**
+  Find the current record in the contents of RW_NVRAM.
+
+  @param[in]  Region      The region.
+  @param[in]  Size        Its size, a multiple of VBOOT_NV_RECORD_SIZE.
+  @param[out] Record      The current record if it is valid, otherwise an
+                          empty valid one, as vboot would start from.
+  @param[out] NextOffset  Offset of the first erased record, where the next
+                          one goes; Size if the region is full.
+
+  @retval TRUE   The current record is valid.
+  @retval FALSE  There is none, or it is corrupted.
+**/
+BOOLEAN
+FmpVbootNvFindCurrent (
+  IN  CONST UINT8  *Region,
+  IN  UINTN        Size,
+  OUT UINT8        Record[VBOOT_NV_RECORD_SIZE],
+  OUT UINTN        *NextOffset
+  );
+
+/**
+  The slot that vboot booted, 0 for A and 1 for B.
+**/
+UINTN
+FmpVbootNvTriedSlot (
+  IN CONST UINT8  Record[VBOOT_NV_RECORD_SIZE]
+  );
+
+/**
+  Ask vboot to try Slot on the next boots: try_next, and the try count.
+**/
+VOID
+FmpVbootNvSetTryNext (
+  IN OUT UINT8  Record[VBOOT_NV_RECORD_SIZE],
+  IN     UINTN  Slot,
+  IN     UINT8  Tries
+  );
-- 
