 .../FmpDeviceSmmLib/FmpDeviceSmmVboot.c       | 169 +++++++++++++++
 .../FmpDeviceSmmLib/FmpDeviceSmmVboot.h       | 107 ++++++++++
 4 files changed, 472 insertions(+)
