@@ -23,7 +23,7 @@ config BOARD_SPECIFIC_OPTIONS
 config VBOOT
 	select VBOOT_MUST_REQUEST_DISPLAY
 	select VBOOT_STARTS_IN_BOOTBLOCK
-	select VBOOT_VBNV_CMOS
+	select VBOOT_VBNV_FLASH	# ouroBIOS update test: nvdata in RW_NVRAM
 	select GBB_FLAG_DISABLE_LID_SHUTDOWN
 	select GBB_FLAG_DISABLE_PD_SOFTWARE_SYNC
 	select GBB_FLAG_DISABLE_EC_SOFTWARE_SYNC
@@ -54,6 +54,11 @@ config VBOOT_SLOTS_RW_A
 
 endif
 
+# ouroBIOS update test: only the bootblock, with verstage, in the read-only
+# CBFS, the rest in the RW slots, as on the W541
+config RW_REGION_ONLY
+	default "fallback/romstage fallback/postcar fallback/ramstage fallback/dsdt.aml fallback/payload" if VBOOT
+
 config VBOOT_VBNV_OFFSET
 	hex
 	default 0x2c
