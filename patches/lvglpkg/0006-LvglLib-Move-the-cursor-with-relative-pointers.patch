 }
 
+//
+// Convert relative motion, in counts at Resolution counts per mm, to pixels.
+// Rest carries the fraction of a pixel (in 1/256 px) over to the next read.
+//
+STATIC
+INT32
+RelativeToPixels (
+  IN     INT32   Motion,
+  IN     UINT64  Resolution,
+  IN OUT INT64   *Rest
+  )
+{
+  INT64  Q8;
+  INT64  Limit;
+  INT64  Pixels;
+
+  if ((Motion == 0) || (Resolution == 0)) {
+    return 0;
+  }
+
+  Q8    = ((INT64)Motion * LVGL_POINTER_PX_PER_MM * 256) / (INT64)Resolution;
+  Limit = (INT64)LVGL_POINTER_ACCEL_PX * 256;
+  if (Q8 > Limit) {
+    Q8 += Q8 - Limit;
+  } else if (Q8 < -Limit) {
+    Q8 += Q8 + Limit;
+  }
+
+  Q8    += *Rest;
+  Pixels = Q8 / 256;
+  *Rest  = Q8 - Pixels * 256;
+  return (INT32)Pixels;
+}
+
+//
+// Read the relative pointer, if any, and move the cursor by its motion.
+//
+// @retval TRUE   The pointer moved or a button is down.
+// @retval FALSE  No activity.
+//
+STATIC
+BOOLEAN
+relative_pointer_read (
+  IN INT32  hor_res,
+  IN INT32  ver_res
+  )
+{
+  EFI_STATUS                Status;
+  EFI_SIMPLE_POINTER_STATE  RelState;
+  INT32                     Dx;
+  INT32                     Dy;
+
+  if (mRelPointer == NULL) {
+    gBS->HandleProtocol (
+           gST->ConsoleInHandle,
+           &gEfiSimplePointerProtocolGuid,
+           (VOID **)&mRelPointer);
+    if (mRelPointer == NULL) {
+      return FALSE;
+    }
+  }
+
+  Status = mRelPointer->GetState (mRelPointer, &RelState);
+  if (EFI_ERROR (Status)) {
+    //
+    // EFI_NOT_READY: no motion and no button change since the last read.
+    //
+    return mRelLeftButton;
+  }
+
+  Dx = RelativeToPixels (RelState.RelativeMovementX, mRelPointer->Mode->ResolutionX, &mRelRestX);
+  Dy = RelativeToPixels (RelState.RelativeMovementY, mRelPointer->Mode->ResolutionY, &mRelRestY);
+
+  mLastCursorX += Dx;
+  if (mLastCursorX > hor_res - 1) mLastCursorX = hor_res - 1;
+  if (mLastCursorX < 0)           mLastCursorX = 0;
+
+  mLastCursorY += Dy;
+  if (mLastCursorY > ver_res - 1) mLastCursorY = ver_res - 1;
+  if (mLastCursorY < 0)           mLastCursorY = 0;
+
+  mRelLeftButton = RelState.LeftButton;
+  if ((Dx != 0) || (Dy != 0) || mRelLeftButton) {
+    mRelSeen = TRUE;
+    return TRUE;
+  }
+
+  return FALSE;
+}
+
 //
 // Custom pointer read callback.
 //
 // Performs a single GetState() per frame, updating cursor position, button
 // state, and the wheel accumulator.  Applies wheel scroll when the ratchet
-// threshold is crossed.
+// threshold is crossed. A relative pointer, read after the absolute one,
+// moves the same cursor.
 //
 static void
 mouse_read (
@@ -153,6 +267,10 @@ mouse_read (
