 STATIC INT32                          mWheelDelta    = 0;
 STATIC BOOLEAN                        mLeftButton    = FALSE;
 
+//
+// Relative pointer state: the protocol, the fractions of a pixel left over
+// (in 1/256 px), the left button, and whether it has moved at all.
+//
+STATIC EFI_SIMPLE_POINTER_PROTOCOL    *mRelPointer   = NULL;
+STATIC INT64                          mRelRestX      = 0;
+STATIC INT64                          mRelRestY      = 0;
+STATIC BOOLEAN                        mRelLeftButton = FALSE;
+STATIC BOOLEAN                        mRelSeen       = FALSE;
+
 //
 // The mouse cursor image. Hidden until an absolute pointer (mouse) is actually
 // present, so a machine with no mouse doesn't show a dead cursor stuck in the
@@ -131,12 +154,103 @@ find_scrollable_at_point (
