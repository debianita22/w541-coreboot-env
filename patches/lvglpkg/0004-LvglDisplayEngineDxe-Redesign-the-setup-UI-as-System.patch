+    { "Delete Boot",          LV_SYMBOL_TRASH,     THEME_COLOR_ICON_RED    },
+    { "From File",            LV_SYMBOL_DIRECTORY, THEME_COLOR_ICON_BLUE   },
+    { "System Configuration", LV_SYMBOL_BARS,      THEME_COLOR_ICON_GRAY   },
+    { "Platform Setup",       LV_SYMBOL_SETTINGS,  THEME_COLOR_ICON_BLUE   },
+    //
+    // Categories of the setup menu.
+    //
+    { "General",              LV_SYMBOL_SETTINGS,     THEME_COLOR_ICON_GRAY   },
+    { "Energy",               LV_SYMBOL_BATTERY_FULL, THEME_COLOR_ICON_GREEN  },
+    { "Security",             LV_SYMBOL_EYE_CLOSE,    THEME_COLOR_ICON_BLUE   },
+    { "Keyboard",             LV_SYMBOL_KEYBOARD,     THEME_COLOR_ICON_TEAL   },
+    { "Hardware",             LV_SYMBOL_SD_CARD,      THEME_COLOR_ICON_PURPLE },
+    { "Voltage",              LV_SYMBOL_CHARGE,       THEME_COLOR_ICON_ORANGE },
