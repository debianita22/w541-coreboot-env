+/**
+  Create a rounded square of the given color with a white symbol, the icon
+  of a menu entry.
+**/
+STATIC
+lv_obj_t *
+CreateIconSquare (
+  IN lv_obj_t         *Parent,
+  IN CONST CHAR8      *Symbol,
+  IN UINT32           Color,
+  IN int32_t          Size,
+  IN CONST lv_font_t  *Font
+  )
+{
+  lv_obj_t  *Square;
+  lv_obj_t  *Label;
+
+  Square = lv_obj_create (Parent);
+  lv_obj_remove_style_all (Square);
+  lv_obj_set_size (Square, Size, Size);
+  lv_obj_set_style_radius (Square, THEME_RADIUS_ICON, 0);
+  lv_obj_set_style_bg_color (Square, lv_color_hex (Color), 0);
+  lv_obj_set_style_bg_opa (Square, LV_OPA_COVER, 0);
+  lv_obj_clear_flag (Square, LV_OBJ_FLAG_CLICKABLE);
+  lv_obj_clear_flag (Square, LV_OBJ_FLAG_SCROLLABLE);
+
+  Label = lv_label_create (Square);
+  lv_label_set_text (Label, Symbol);
+  lv_obj_set_style_text_font (Label, Font, 0);
+  lv_obj_set_style_text_color (Label, lv_color_white (), 0);
+  lv_obj_center (Label);
+  return Square;
+}
+
+/**
+  Symbol of a menu entry: the matching symbol, or for entries without one
+  the first letter of the prompt, written to Letter.
+
+  @param[in]  Prompt  Prompt of the entry.
+  @param[out] Letter  Buffer of two characters for the letter.
+  @param[out] Color   Color of the symbol.
+
+  @return The symbol: a constant string or Letter.
+**/
+STATIC
+CONST CHAR8 *
+PromptSymbol (
+  IN  CONST CHAR8  *Prompt,
+  OUT CHAR8        *Letter,
+  OUT UINT32       *Color
+  )
+{
+  CONST CHAR8  *Symbol;
+  CONST CHAR8  *Walk;
+
+  Symbol = LookupPromptIcon (Prompt, Color);
+  if (Symbol != NULL) {
+    return Symbol;
+  }
+
+  Letter[0] = '?';
+  Letter[1] = '\0';
+  for (Walk = Prompt; (Walk != NULL) && (*Walk != '\0'); Walk++) {
+    if (((*Walk >= 'A') && (*Walk <= 'Z')) || ((*Walk >= '0') && (*Walk <= '9'))) {
+      Letter[0] = *Walk;
+      break;
+    }
+
+    if ((*Walk >= 'a') && (*Walk <= 'z')) {
+      Letter[0] = (CHAR8)(*Walk - 'a' + 'A');
+      break;
+    }
+  }
+
+  return Letter;
+}
+
+/**
+  Create the icon of a menu entry: the matching symbol, or for entries
+  without one the first letter of the prompt, on a rounded square.
+**/
+STATIC
+lv_obj_t *
+CreatePromptIcon (
+  IN lv_obj_t         *Parent,
+  IN CONST CHAR8      *Prompt,
+  IN int32_t          Size,
+  IN CONST lv_font_t  *Font
+  )
+{
+  CONST CHAR8  *Symbol;
+  UINT32       Color;
+  CHAR8        Letter[2];
+
+  Symbol = PromptSymbol (Prompt, Letter, &Color);
+
+  //
+  // lv_label_set_text() copies the text, so a stack buffer is fine.
+  //
+  return CreateIconSquare (Parent, Symbol, Color, Size, Font);
+}
+
+/**
+  Split a front-page banner line of the form "Key: Value" (for example
+  " FW: <version> <date>"). Leading blanks are skipped.
+
+  @param[in]  Text    Banner text.
+  @param[out] Key     Start of the key (not terminated), or NULL.
+  @param[out] KeyLen  Length of the key.
+
+  @return Start of the value: the whole (trimmed) text when there is no
+          short "Key: " prefix.
+**/
+STATIC
+CONST CHAR8 *
+SplitBannerText (
+  IN  CONST CHAR8  *Text,
+  OUT CONST CHAR8  **Key,
+  OUT UINTN        *KeyLen
+  )
+{
+  CONST CHAR8  *Colon;
+
+  while ((*Text == ' ') || (*Text == '\t')) {
+    Text++;
+  }
+
+  *Key    = NULL;
+  *KeyLen = 0;
+
+  Colon = AsciiStrStr (Text, ": ");
+  if ((Colon == NULL) || (Colon == Text) || ((UINTN)(Colon - Text) > 12)) {
+    return Text;
+  }
+
+  *Key    = Text;
+  *KeyLen = (UINTN)(Colon - Text);
+  return Colon + 2;
+}
