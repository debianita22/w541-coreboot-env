+/**
+  Area of a menu entry, chosen from words in its prompt. The first match
+  wins: "Reboot", "Secure Boot" and "Boot Splash" must not land in the boot
+  area, "Graphical UI Configuration" not in the system one.
+**/
+STATIC
+LVGL_MENU_AREA
+LookupMenuArea (
+  IN CONST CHAR8  *Prompt
+  )
+{
+  STATIC CONST struct {
+    CONST CHAR8       *Word;
+    LVGL_MENU_AREA    Area;
+  } Map[] = {
+    { "Reboot",        LvglAreaPower    },
+    { "Shutdown",      LvglAreaPower    },
+    { "Power Off",     LvglAreaPower    },
+    { "Restart",       LvglAreaPower    },
+    { "Secure Boot",   LvglAreaSecurity },
+    { "Password",      LvglAreaSecurity },
+    { "TPM",           LvglAreaSecurity },
+    { "Tcg",           LvglAreaSecurity },
+    { "Splash",        LvglAreaDisplay  },
+    { "Graphical",     LvglAreaDisplay  },
+    { "Display",       LvglAreaDisplay  },
+    { "Boot",          LvglAreaBoot     },
+    { "Shell",         LvglAreaBoot     },
+    { "Time",          LvglAreaGeneral  },
+    { "Date",          LvglAreaGeneral  },
+    { "Language",      LvglAreaGeneral  },
+    { "Configuration", LvglAreaSystem   },
+    { "Platform",      LvglAreaDevices  },
+    { "Device",        LvglAreaDevices  },
+    { "Network",       LvglAreaDevices  },
+    { "Driver",        LvglAreaDevices  },
+  };
+  UINTN  Idx;
+
+  if (Prompt != NULL) {
+    for (Idx = 0; Idx < ARRAY_SIZE (Map); Idx++) {
+      if (AsciiStrStr (Prompt, Map[Idx].Word) != NULL) {
+        return Map[Idx].Area;
+      }
+    }
+  }
+
+  return LvglAreaMore;
+}
