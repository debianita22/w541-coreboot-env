+/**
+  Decide whether the form is laid out as a menu in areas: the front page and
+  System Configuration, when every entry opens another form or runs an
+  action. Also sets the number of area columns: one per area, at most three
+  on the front page and two next to the help card.
+**/
+STATIC
+BOOLEAN
+IsGroupedMenuForm (
+  IN FORM_DISPLAY_ENGINE_FORM  *FormData
+  )
+{
+  LIST_ENTRY                     *Link;
+  FORM_DISPLAY_ENGINE_STATEMENT  *Statement;
+  BOOLEAN                        IsFrontPage;
+  BOOLEAN                        Seen[LvglAreaMore + 1];
+  UINTN                          Areas;
+  UINTN                          Entries;
+  CHAR8                          *Prompt;
+  LVGL_MENU_AREA                 Area;
+
+  mAreaColumnCount = 0;
+  ZeroMem (mGridCount, sizeof (mGridCount));
+  IsFrontPage      = CompareGuid (&FormData->FormSetGuid, &mFrontPageFormSetGuid);
+  if (!IsFrontPage && !CompareGuid (&FormData->FormSetGuid, &mDeviceManagerFormSetGuid)) {
+    return FALSE;
+  }
+
+  ZeroMem (Seen, sizeof (Seen));
+  Areas   = 0;
+  Entries = 0;
+  for (Link = FormData->StatementListHead.ForwardLink;
+       Link != &FormData->StatementListHead;
+       Link = Link->ForwardLink)
+  {
+    Statement = FORM_DISPLAY_ENGINE_STATEMENT_FROM_LINK (Link);
+    if (Statement->Attribute & HII_DISPLAY_SUPPRESS) {
+      continue;
+    }
+
+    switch (Statement->OpCode->OpCode) {
+      case EFI_IFR_REF_OP:
+      case EFI_IFR_ACTION_OP:
+        Prompt = GetPromptUtf8 (Statement, FormData->HiiHandle);
+        Area   = LookupMenuArea (Prompt);
+        if (Prompt != NULL) {
+          FreePool (Prompt);
+        }
+
+        if (!Seen[Area]) {
+          Seen[Area] = TRUE;
+          Areas++;
+        }
+
+        mGridCount[GridSectionOfArea (Area)]++;
+        Entries++;
+        break;
+
+      case EFI_IFR_CHECKBOX_OP:
+      case EFI_IFR_NUMERIC_OP:
+      case EFI_IFR_ONE_OF_OP:
+      case EFI_IFR_ORDERED_LIST_OP:
+      case EFI_IFR_STRING_OP:
+      case EFI_IFR_PASSWORD_OP:
+      case EFI_IFR_DATE_OP:
+      case EFI_IFR_TIME_OP:
+        return FALSE;
+
+      default:
+        break;
+    }
+  }
+
+  if (Entries < 2) {
+    return FALSE;
+  }
+
+  mAreaColumnCount = MIN (Areas, IsFrontPage ? 3 : 2);
+  return TRUE;
+}
