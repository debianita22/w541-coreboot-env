+/**
+  Return the card of a menu area, creating the area -- a header and a card
+  -- in the column with the least content when it is new.
+**/
+STATIC
+lv_obj_t *
+AreaCard (
+  IN lv_obj_t        *Parent,
+  IN LVGL_MENU_AREA  Area
+  )
+{
+  UINTN     Idx;
+  UINTN     Column;
+  lv_obj_t  *Group;
+  lv_obj_t  *Header;
+
+  if (mAreaRow == NULL) {
+    mAreaRow = CreateBox (Parent);
+    lv_obj_set_size (mAreaRow, LV_PCT (100), LV_SIZE_CONTENT);
+    lv_obj_set_flex_flow (mAreaRow, LV_FLEX_FLOW_ROW);
+    lv_obj_set_style_pad_column (mAreaRow, THEME_PAD_AREA_GAP, 0);
+
+    for (Idx = 0; Idx < mAreaColumnCount; Idx++) {
+      mAreaColumns[Idx] = CreateBox (mAreaRow);
+      lv_obj_set_height (mAreaColumns[Idx], LV_SIZE_CONTENT);
+      lv_obj_set_flex_grow (mAreaColumns[Idx], 1);
+      lv_obj_set_flex_flow (mAreaColumns[Idx], LV_FLEX_FLOW_COLUMN);
+      lv_obj_set_style_pad_row (mAreaColumns[Idx], THEME_PAD_AREA_GAP, 0);
+      mAreaColumnWeight[Idx] = 0;
+    }
+  }
+
+  for (Idx = 0; Idx < mAreaCount; Idx++) {
+    if (mAreas[Idx].Area == Area) {
+      mAreaColumnWeight[mAreas[Idx].Column]++;
+      return mAreas[Idx].Card;
+    }
+  }
+
+  Column = 0;
+  for (Idx = 1; Idx < mAreaColumnCount; Idx++) {
+    if (mAreaColumnWeight[Idx] < mAreaColumnWeight[Column]) {
+      Column = Idx;
+    }
+  }
+
+  Group = CreateBox (mAreaColumns[Column]);
+  lv_obj_set_size (Group, LV_PCT (100), LV_SIZE_CONTENT);
+  lv_obj_set_flex_flow (Group, LV_FLEX_FLOW_COLUMN);
+  lv_obj_set_style_pad_row (Group, THEME_PAD_AREA_HEADER_GAP, 0);
+
+  Header = lv_label_create (Group);
+  lv_label_set_text (Header, MenuAreaTitle (Area));
+  lv_obj_set_style_text_font (Header, LvglThemeFontSmall (), 0);
+  lv_obj_set_style_text_color (Header, lv_color_hex (THEME_COLOR_SECTION_TEXT), 0);
+  lv_obj_set_style_pad_left (Header, THEME_PAD_SECTION_X, 0);
+
+  //
+  // Header and first row.
+  //
+  mAreaColumnWeight[Column] += 2;
+
+  if (mAreaCount < LVGL_AREA_MAX) {
+    mAreas[mAreaCount].Area   = Area;
+    mAreas[mAreaCount].Column = Column;
+    mAreas[mAreaCount].Card   = CreateCard (Group);
+    return mAreas[mAreaCount++].Card;
+  }
+
+  return CreateCard (Group);
+}
+
+/**
+  Number of columns of the front-page grid: as many as fit in Width, at
+  most THEME_GRID_COLUMNS_MAX, and no more than needed to spread the
+  tiles of each section evenly over its rows.
+**/
+STATIC
+UINTN
+GridColumns (
+  IN int32_t  Width
+  )
+{
+  UINTN  MaxColumns;
+  UINTN  Columns;
+  UINTN  Rows;
+  UINTN  Idx;
+
+  MaxColumns = 1;
+  if (Width > (int32_t)THEME_TILE_WIDTH) {
+    MaxColumns = ((UINTN)Width + THEME_PAD_TILE_GAP_X) / (THEME_TILE_WIDTH + THEME_PAD_TILE_GAP_X);
+  }
+
+  MaxColumns = MAX (1, MIN (MaxColumns, THEME_GRID_COLUMNS_MAX));
+  Columns    = 1;
+  for (Idx = 0; Idx < LVGL_GRID_SECTIONS; Idx++) {
+    if (mGridCount[Idx] == 0) {
+      continue;
+    }
+
+    Rows    = (mGridCount[Idx] + MaxColumns - 1) / MaxColumns;
+    Columns = MAX (Columns, (mGridCount[Idx] + Rows - 1) / Rows);
+  }
+
+  return Columns;
+}
+
+/**
+  Return the section of the front-page grid that receives a tile. The
+  first call builds the grid in Parent: the sections that have tiles, a
+  divider between them, and the caption that shows the help of the focused
+  entry.
+**/
+STATIC
+lv_obj_t *
+GridSection (
+  IN lv_obj_t  *Parent,
+  IN UINTN     Section
+  )
+{
+  lv_obj_t  *Grid;
+  int32_t   Width;
+  UINTN     Columns;
+  UINTN     Idx;
+
+  if (mGridCaption == NULL) {
+    lv_obj_update_layout (Parent);
+    Columns = GridColumns (lv_obj_get_content_width (Parent));
+    Width   = (int32_t)(Columns * THEME_TILE_WIDTH + (Columns - 1) * THEME_PAD_TILE_GAP_X);
+
+    Grid = CreateBox (Parent);
+    lv_obj_set_size (Grid, Width, LV_SIZE_CONTENT);
+    lv_obj_set_flex_flow (Grid, LV_FLEX_FLOW_COLUMN);
+    lv_obj_set_flex_align (Grid, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+    lv_obj_set_style_pad_row (Grid, THEME_PAD_GRID_SECTION_GAP, 0);
+
+    for (Idx = 0; Idx < LVGL_GRID_SECTIONS; Idx++) {
+      if (mGridCount[Idx] == 0) {
+        continue;
+      }
+
+      if ((Idx > 0) && (mGridSection[0] != NULL)) {
+        CreateFilledBox (Grid, LV_PCT (100), THEME_BORDER_PANE, 0, THEME_COLOR_HOME_DIVIDER, LV_OPA_COVER);
+      }
+
+      //
+      // Tiles are the scroll targets (LV_OBJ_FLAG_USER_1, see
+      // NavScrollTarget), not the whole grid.
+      //
+      mGridSection[Idx] = CreateBox (Grid);
+      lv_obj_set_size (mGridSection[Idx], LV_PCT (100), LV_SIZE_CONTENT);
+      lv_obj_set_flex_flow (mGridSection[Idx], LV_FLEX_FLOW_ROW_WRAP);
+      lv_obj_set_flex_align (mGridSection[Idx], LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_START);
+      lv_obj_set_style_pad_column (mGridSection[Idx], THEME_PAD_TILE_GAP_X, 0);
+      lv_obj_set_style_pad_row (mGridSection[Idx], THEME_PAD_TILE_GAP_Y, 0);
+      lv_obj_add_flag (mGridSection[Idx], LV_OBJ_FLAG_USER_1);
+    }
+
+    mGridCaption = lv_label_create (Grid);
+    lv_label_set_long_mode (mGridCaption, LV_LABEL_LONG_WRAP);
+    lv_obj_set_width (mGridCaption, LV_PCT (100));
+    lv_obj_set_style_text_font (mGridCaption, LvglThemeFontSmall (), 0);
+    lv_obj_set_style_text_color (mGridCaption, lv_color_hex (THEME_COLOR_GRID_CAPTION), 0);
+    lv_obj_set_style_text_align (mGridCaption, LV_TEXT_ALIGN_CENTER, 0);
+    lv_obj_set_style_min_height (mGridCaption, lv_font_get_line_height (LvglThemeFontSmall ()), 0);
+    lv_label_set_text (mGridCaption, "");
+  }
+
+  if (mGridSection[Section] == NULL) {
+    Section = (mGridSection[0] != NULL) ? 0 : 1;
+  }
+
+  return mGridSection[Section];
+}
