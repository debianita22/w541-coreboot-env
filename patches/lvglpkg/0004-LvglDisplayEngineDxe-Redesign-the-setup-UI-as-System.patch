+  return (BOOLEAN)(!EFI_ERROR (Status) && (Size == sizeof (Value)) && (Value == 1));
+}
+
+/**
+  TRUE when a USB storage device is connected.
+**/
+STATIC
+BOOLEAN
+ChromeUsbStoragePresent (
+  VOID
+  )
+{
+  EFI_STATUS                Status;
+  EFI_HANDLE                *Handles;
+  UINTN                     Count;
+  UINTN                     Idx;
+  EFI_BLOCK_IO_PROTOCOL     *BlockIo;
+  EFI_DEVICE_PATH_PROTOCOL  *Node;
+  BOOLEAN                   Found;
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiBlockIoProtocolGuid, NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    return FALSE;
+  }
+
+  Found = FALSE;
+  for (Idx = 0; (Idx < Count) && !Found; Idx++) {
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Idx], &gEfiBlockIoProtocolGuid, (VOID **)&BlockIo)) ||
+        BlockIo->Media->LogicalPartition)
+    {
+      continue;
+    }
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Idx], &gEfiDevicePathProtocolGuid, (VOID **)&Node))) {
+      continue;
+    }
+
+    for ( ; !IsDevicePathEnd (Node); Node = NextDevicePathNode (Node)) {
+      if ((DevicePathType (Node) == MESSAGING_DEVICE_PATH) &&
+          ((DevicePathSubType (Node) == MSG_USB_DP) ||
+           (DevicePathSubType (Node) == MSG_USB_CLASS_DP) ||
+           (DevicePathSubType (Node) == MSG_USB_WWID_DP)))
+      {
+        Found = TRUE;
+        break;
+      }
+    }
+  }
+
+  FreePool (Handles);
+  return Found;
+}
+
+/**
+  Read the battery level from the battery status protocol.
+**/
+STATIC
+EFI_STATUS
+ChromeReadBattery (
+  OUT UINT8    *Percent,
+  OUT BOOLEAN  *Charging
+  )
+{
+  EFI_BATTERY_STATUS_PROTOCOL  *Battery;
+  EFI_STATUS                   Status;
+  EFI_TPL                      OldTpl;
+  BOOLEAN                      Present;
+
+  Status = gBS->LocateProtocol (&gEfiBatteryStatusProtocolGuid, NULL, (VOID **)&Battery);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  //
+  // The front page polls the same EC from a TPL_CALLBACK timer: keep the
+  // two from interleaving their EC transactions.
+  //
+  OldTpl = gBS->RaiseTPL (TPL_HIGH_LEVEL);
+  gBS->RestoreTPL (OldTpl);
+  if (OldTpl < TPL_CALLBACK) {
+    OldTpl = gBS->RaiseTPL (TPL_CALLBACK);
+    Status = Battery->GetBatteryInfo (Battery, Percent, &Present, Charging);
+    gBS->RestoreTPL (OldTpl);
+  } else {
+    Status = Battery->GetBatteryInfo (Battery, Percent, &Present, Charging);
+  }
+
+  if (!EFI_ERROR (Status) && (!Present || (*Percent > 100))) {
+    Status = EFI_NOT_FOUND;
+  }
+
+  return Status;
+}
+
+/**
+  Refresh the battery item of the menu bar: level and symbol, hidden when
+  there is no battery.
+**/
+STATIC
+VOID
+ChromeRefreshBattery (
+  VOID
+  )
+{
+  UINT8        Percent;
+  BOOLEAN      Charging;
+  CONST CHAR8  *Symbol;
+  CHAR8        Buf[32];
+
+  if (mBatteryLabel == NULL) {
+    return;
+  }
+
+  if (EFI_ERROR (ChromeReadBattery (&Percent, &Charging))) {
+    lv_obj_add_flag (mBatteryLabel, LV_OBJ_FLAG_HIDDEN);
+    return;
+  }
+
+  if (Percent >= 90) {
+    Symbol = LV_SYMBOL_BATTERY_FULL;
+  } else if (Percent >= 65) {
+    Symbol = LV_SYMBOL_BATTERY_3;
+  } else if (Percent >= 40) {
+    Symbol = LV_SYMBOL_BATTERY_2;
+  } else if (Percent >= 15) {
+    Symbol = LV_SYMBOL_BATTERY_1;
+  } else {
+    Symbol = LV_SYMBOL_BATTERY_EMPTY;
+  }
+
+  AsciiSPrint (Buf, sizeof (Buf), "%d%%  %a%a", Percent, Symbol, Charging ? " " LV_SYMBOL_CHARGE : "");
+  ChromeSetLabelText (mBatteryLabel, Buf);
+  lv_obj_clear_flag (mBatteryLabel, LV_OBJ_FLAG_HIDDEN);
+}
+
+/**
+  Day of the week, 0 = Sunday (Sakamoto's method).
+**/
+STATIC
+UINTN
+ChromeDayOfWeek (
+  IN UINTN  Year,
+  IN UINTN  Month,
+  IN UINTN  Day
+  )
+{
+  STATIC CONST UINT8  Offset[] = { 0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4 };
+
+  if (Month < 3) {
+    Year--;
+  }
+
+  return (Year + Year / 4 - Year / 100 + Year / 400 + Offset[Month - 1] + Day) % 7;
+}
