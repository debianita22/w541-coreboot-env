+/**
+  In a menu laid out in columns, find the entry to focus for LEFT/RIGHT: in
+  the nearest column on that side, the entry closest to the focused one.
+
+  @return The entry, or NULL when there is no column on that side.
+**/
+STATIC
+lv_obj_t *
+FindNavInNextColumn (
+  IN lv_obj_t  *Focused,
+  IN BOOLEAN   Right
+  )
+{
+  lv_area_t  From;
+  lv_area_t  To;
+  int32_t    Dx;
+  int32_t    Dy;
+  int32_t    BestDx;
+  int32_t    BestDy;
+  lv_obj_t   *Best;
+  UINTN      Idx;
+
+  if (Focused == NULL) {
+    return NULL;
+  }
+
+  lv_obj_get_coords (Focused, &From);
+  Best   = NULL;
+  BestDx = 0;
+  BestDy = 0;
+  for (Idx = 0; Idx < mNavCount; Idx++) {
+    lv_obj_get_coords (mNavList[Idx], &To);
+
+    //
+    // Only entries of another column, on the requested side.
+    //
+    if (Right ? (To.x1 <= From.x2) : (To.x2 >= From.x1)) {
+      continue;
+    }
+
+    Dx = Right ? (To.x1 - From.x1) : (From.x1 - To.x1);
+    Dy = ((To.y1 + To.y2) / 2) - ((From.y1 + From.y2) / 2);
+    if (Dy < 0) {
+      Dy = -Dy;
+    }
+
+    if ((Best == NULL) || (Dx < BestDx) || ((Dx == BestDx) && (Dy < BestDy))) {
+      Best   = mNavList[Idx];
+      BestDx = Dx;
+      BestDy = Dy;
+    }
+  }
+
+  return Best;
+}
+
+/**
+  In the front-page grid, find the tile to focus for an arrow key.
+
+  LEFT/RIGHT move along the row and, at its ends, on to the previous or
+  next tile in reading order (the navigation list is sorted by rows).
+  UP/DOWN move to the nearest row above or below, onto the tile closest to
+  the focused one, and wrap around from the last row to the first and back.
+  Tiles of a row share their top edge.
+
+  @return The tile, or NULL to keep the focus.
+**/
+STATIC
+lv_obj_t *
+FindNavInGrid (
+  IN lv_obj_t  *Focused,
+  IN lv_key_t  Key
+  )
+{
+  lv_area_t  From;
+  lv_area_t  To;
+  BOOLEAN    Horizontal;
+  BOOLEAN    Forward;
+  int32_t    Primary;
+  int32_t    Secondary;
+  int32_t    BestPrimary;
+  int32_t    BestSecondary;
+  lv_obj_t   *Best;
+  UINTN      Idx;
+  UINTN      Pass;
+
+  if (mNavCount == 0) {
+    return NULL;
+  }
+
+  for (Idx = 0; Idx < mNavCount; Idx++) {
+    if (mNavList[Idx] == Focused) {
+      break;
+    }
+  }
+
+  if ((Focused == NULL) || (Idx == mNavCount)) {
+    return mNavList[0];
+  }
+
+  Horizontal = (BOOLEAN)((Key == LV_KEY_LEFT) || (Key == LV_KEY_RIGHT));
+  Forward    = (BOOLEAN)((Key == LV_KEY_RIGHT) || (Key == LV_KEY_DOWN));
+  lv_obj_get_coords (Focused, &From);
+
+  //
+  // Pass 0: the nearest tile on that side. Pass 1 (UP/DOWN): wrap around
+  // to the row farthest on the other side.
+  //
+  Best          = NULL;
+  BestPrimary   = 0;
+  BestSecondary = 0;
+  for (Pass = 0; (Pass < 2) && (Best == NULL); Pass++) {
+    if (Horizontal && (Pass > 0)) {
+      break;
+    }
+
+    for (Idx = 0; Idx < mNavCount; Idx++) {
+      if (mNavList[Idx] == Focused) {
+        continue;
+      }
+
+      lv_obj_get_coords (mNavList[Idx], &To);
+      if (Horizontal) {
+        if (To.y1 != From.y1) {
+          continue;
+        }
+
+        Primary   = Forward ? (To.x1 - From.x1) : (From.x1 - To.x1);
+        Secondary = 0;
+      } else {
+        Primary   = Forward ? (To.y1 - From.y1) : (From.y1 - To.y1);
+        Secondary = (To.x1 > From.x1) ? (To.x1 - From.x1) : (From.x1 - To.x1);
+        if (Pass > 0) {
+          //
+          // Wrapping: the farthest row on the other side comes first.
+          //
+          if (Primary >= 0) {
+            continue;
+          }
+
+          Primary = MAX_INT32 + Primary;
+        }
+      }
+
+      if (Primary <= 0) {
+        continue;
+      }
+
+      if ((Best == NULL) || (Primary < BestPrimary) ||
+          ((Primary == BestPrimary) && (Secondary < BestSecondary)))
+      {
+        Best          = mNavList[Idx];
+        BestPrimary   = Primary;
+        BestSecondary = Secondary;
+      }
+    }
+  }
+
+  if ((Best == NULL) && Horizontal) {
+    for (Idx = 0; Idx < mNavCount; Idx++) {
+      if (mNavList[Idx] == Focused) {
+        break;
+      }
     }
+
+    if (Forward) {
+      Idx = (Idx + 1) % mNavCount;
+    } else {
+      Idx = (Idx == 0) ? (mNavCount - 1) : (Idx - 1);
+    }
+
+    Best = mNavList[Idx];
   }
 
-  return FALSE;
+  return (Best != Focused) ? Best : NULL;
 }
 
