 /**
-  Get help text for a statement as UTF-8. Caller must FreePool().
+  Join the lines of a help text where a sentence goes on: help strings are
+  often broken for the 80-column text UI, while the help card wraps the
+  text itself. A line break stays after the end of a sentence or a colon,
+  around an empty line and before a list item ("-" or "*").
+
+  @param[in, out] Text  NUL-terminated UTF-8 text, changed in place.
+**/
+STATIC
+VOID
+ReflowHelpText (
+  IN OUT CHAR8  *Text
+  )
+{
+  CHAR8  *Read;
+  CHAR8  *Write;
+  CHAR8  *Back;
+  CHAR8  Next;
+
+  //
+  // CR LF -> LF
+  //
+  for (Read = Text, Write = Text; *Read != '\0'; Read++) {
+    if (*Read != '\r') {
+      *Write++ = *Read;
+    }
+  }
+
+  *Write = '\0';
+
+  for (Read = Text; *Read != '\0'; Read++) {
+    if (*Read != '\n') {
+      continue;
+    }
+
+    Back = Read;
+    while ((Back > Text) && (Back[-1] == ' ')) {
+      Back--;
+    }
+
+    if (Back == Text) {
+      continue;
+    }
+
+    Next = Read[1];
+    if ((Back[-1] == '.') || (Back[-1] == ':') || (Back[-1] == '!') ||
+        (Back[-1] == '?') || (Back[-1] == '\n') || (Next == '\n') ||
+        (Next == '-') || (Next == '*') || (Next == '\0'))
+    {
+      continue;
+    }
+
+    *Read = ' ';
+  }
+}
+
+/**
+  Get help text for a statement as UTF-8, with the lines of its sentences
+  joined (ReflowHelpText). Caller must FreePool().
   STATEMENT_HEADER.Help is shared by every opcode that embeds it.
 **/
 STATIC
@@ -295,9 +436,351 @@ GetHelpUtf8 (
 
   Utf8 = Ucs2ToUtf8 (Str16);
   FreePool (Str16);
+  if (Utf8 != NULL) {
+    ReflowHelpText (Utf8);
+  }
+
   return Utf8;
 }
 
+/**
+  TRUE when Text is NULL, empty or only blanks (the "empty line" subtitles
+  that forms use as spacers).
+**/
+STATIC
+BOOLEAN
+IsBlankUtf8 (
+  IN CONST CHAR8  *Text
+  )
+{
+  if (Text == NULL) {
+    return TRUE;
+  }
+
+  for ( ; *Text != '\0'; Text++) {
+    if ((*Text != ' ') && (*Text != '\t')) {
+      return FALSE;
+    }
+  }
+
+  return TRUE;
+}
