+/**
+  Append a key/value line to the overview.
+
+  @return The value label.
+**/
+STATIC
+lv_obj_t *
+AddAboutLine (
+  IN lv_obj_t     *Info,
+  IN CONST CHAR8  *Key,
+  IN CONST CHAR8  *Value
+  )
+{
+  lv_obj_t  *Line;
+  lv_obj_t  *KeyLbl;
+  lv_obj_t  *ValueLbl;
+
+  Line = CreateBox (Info);
+  lv_obj_set_size (Line, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
+  lv_obj_set_flex_flow (Line, LV_FLEX_FLOW_ROW);
+  lv_obj_set_style_pad_column (Line, (int32_t)LvglThemePx (12), 0);
+
+  KeyLbl = lv_label_create (Line);
+  lv_label_set_text (KeyLbl, Key);
+  lv_obj_set_width (KeyLbl, THEME_ABOUT_KEY_WIDTH);
+  LvglThemeApplyBodyFont (KeyLbl);
+  lv_obj_set_style_text_color (KeyLbl, lv_color_hex (THEME_COLOR_TEXT_SECONDARY), 0);
+
+  ValueLbl = lv_label_create (Line);
+  lv_label_set_text (ValueLbl, Value);
+  LvglThemeApplyBodyFont (ValueLbl);
+  lv_obj_set_style_text_color (ValueLbl, lv_color_hex (THEME_COLOR_TEXT_PRIMARY), 0);
+  return ValueLbl;
+}
