+/**
+  Order the navigation list of a menu as it reads: column by column, top
+  to bottom, for the menus in columns (areas collect entries from anywhere
+  in the form); row by row, left to right, for the front-page grid.
+**/
+STATIC
+VOID
+SortNavByPosition (
+  IN BOOLEAN  ByRows
+  )
+{
+  UINTN                          Idx;
+  UINTN                          Pos;
+  lv_obj_t                       *Obj;
+  FORM_DISPLAY_ENGINE_STATEMENT  *Stmt;
+  lv_area_t                      Cur;
+  lv_area_t                      Prev;
+
+  for (Idx = 1; Idx < mNavCount; Idx++) {
+    Obj  = mNavList[Idx];
+    Stmt = mNavStatement[Idx];
+    lv_obj_get_coords (Obj, &Cur);
+
+    for (Pos = Idx; Pos > 0; Pos--) {
+      lv_obj_get_coords (mNavList[Pos - 1], &Prev);
+      if (ByRows) {
+        if ((Prev.y1 < Cur.y1) || ((Prev.y1 == Cur.y1) && (Prev.x1 <= Cur.x1))) {
+          break;
+        }
+      } else if ((Prev.x1 < Cur.x1) || ((Prev.x1 == Cur.x1) && (Prev.y1 <= Cur.y1))) {
+        break;
+      }
+
+      mNavList[Pos]      = mNavList[Pos - 1];
+      mNavStatement[Pos] = mNavStatement[Pos - 1];
+    }
+
+    mNavList[Pos]      = Obj;
+    mNavStatement[Pos] = Stmt;
+  }
+}
