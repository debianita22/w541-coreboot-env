+/**
+  Return string number Index of an SMBIOS record, or NULL.
+**/
+STATIC
+CONST CHAR8 *
+ChromeSmbiosString (
+  IN EFI_SMBIOS_TABLE_HEADER  *Record,
+  IN SMBIOS_TABLE_STRING      Index
+  )
+{
+  CONST CHAR8  *Str;
+
+  if (Index == 0) {
+    return NULL;
+  }
+
+  Str = (CONST CHAR8 *)Record + Record->Length;
+  for ( ; Index > 1; Index--) {
+    if (*Str == '\0') {
+      return NULL;
+    }
+
+    Str += AsciiStrLen (Str) + 1;
+  }
+
+  return (*Str != '\0') ? Str : NULL;
+}
