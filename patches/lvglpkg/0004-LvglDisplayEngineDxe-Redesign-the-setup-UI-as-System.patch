+  lv_obj_remove_style_all (Tile);
+  lv_obj_set_size (Tile, THEME_TILE_WIDTH, LV_SIZE_CONTENT);
+  lv_obj_set_flex_flow (Tile, LV_FLEX_FLOW_COLUMN);
+  lv_obj_set_flex_align (Tile, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+  lv_obj_set_style_pad_top (Tile, THEME_PAD_TILE_TOP, 0);
+  lv_obj_set_style_pad_row (Tile, THEME_PAD_TILE_LABEL_GAP, 0);
+  lv_obj_clear_flag (Tile, LV_OBJ_FLAG_SCROLLABLE);
+  lv_obj_add_flag (Tile, LV_OBJ_FLAG_CLICKABLE);
+  lv_obj_add_flag (Tile, LV_OBJ_FLAG_STATE_TRICKLE);
+
+  Square = CreateBox (Tile);
+  lv_obj_set_size (Square, THEME_TILE_SQUARE, THEME_TILE_SQUARE);
+  lv_obj_set_style_radius (Square, THEME_RADIUS_TILE, 0);
+  lv_obj_set_style_bg_color (Square, lv_color_hex (THEME_COLOR_TILE_BG), 0);
+  lv_obj_set_style_bg_opa (Square, LV_OPA_COVER, 0);
+  lv_obj_set_style_border_color (Square, lv_color_hex (THEME_COLOR_TILE_BORDER), 0);
+  lv_obj_set_style_border_width (Square, THEME_BORDER_PANE, 0);
+  lv_obj_set_style_shadow_width (Square, THEME_TILE_SHADOW_WIDTH, 0);
+  lv_obj_set_style_shadow_offset_y (Square, THEME_TILE_SHADOW_OFFSET_Y, 0);
+  lv_obj_set_style_shadow_color (Square, lv_color_black (), 0);
+  lv_obj_set_style_shadow_opa (Square, LV_OPA_40, 0);
+  lv_obj_set_style_bg_color (Square, lv_color_hex (THEME_COLOR_TILE_BG_HOVER), LV_STATE_HOVERED);
+  lv_obj_set_style_bg_color (Square, lv_color_hex (THEME_COLOR_TILE_BG_PRESSED), LV_STATE_PRESSED);
+  lv_obj_set_style_outline_color (Square, lv_color_hex (THEME_COLOR_TILE_FOCUS), LV_STATE_FOCUSED);
+  lv_obj_set_style_outline_opa (Square, LV_OPA_COVER, LV_STATE_FOCUSED);
+  lv_obj_set_style_outline_width (Square, THEME_TILE_FOCUS_BORDER, LV_STATE_FOCUSED);
+  lv_obj_set_style_outline_pad (Square, THEME_PAD_TILE_FOCUS_GAP, LV_STATE_FOCUSED);
+  lv_obj_set_style_opa (Square, LV_OPA_50, LV_STATE_DISABLED);
+
+  Symbol = PromptSymbol (Text, Letter, &Color);
+  Glyph  = lv_label_create (Square);
+  lv_label_set_text (Glyph, Symbol);
+  lv_obj_set_style_text_font (Glyph, LvglThemeFontTile (), 0);
+  lv_obj_set_style_text_color (Glyph, lv_color_hex (Color), 0);
+  lv_obj_center (Glyph);
+
+  Label = lv_label_create (Tile);
+  lv_label_set_text (Label, (Text != NULL) ? Text : "");
+  lv_label_set_long_mode (Label, LV_LABEL_LONG_WRAP);
+  lv_obj_set_width (Label, LV_PCT (100));
+  lv_obj_set_style_text_align (Label, LV_TEXT_ALIGN_CENTER, 0);
+  LvglThemeApplyBodyFont (Label);
+  lv_obj_set_style_text_color (Label, lv_color_hex (THEME_COLOR_TILE_LABEL), 0);
+  lv_obj_set_style_text_color (Label, lv_color_hex (THEME_COLOR_TEXT_TITLE), LV_STATE_FOCUSED);
+  lv_obj_set_style_text_color (Label, lv_color_hex (THEME_COLOR_TEXT_DISABLED), LV_STATE_DISABLED);
+
+  if (Statement->Attribute & HII_DISPLAY_GRAYOUT) {
+    lv_obj_add_state (Tile, LV_STATE_DISABLED);
+  }
+
+  Ctx = AllocateZeroPool (sizeof (LVGL_STATEMENT_CONTEXT));
+  if (Ctx != NULL) {
+    Ctx->Statement = Statement;
+    Ctx->Widget    = Tile;
+    lv_obj_add_event_cb (Tile, OnStatementClicked, LV_EVENT_CLICKED, Ctx);
+  }
+
+  AddToNavGroup (Group, Tile, Ctx);
+}
