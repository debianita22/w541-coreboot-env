+CONST CHAR8 *
+EFIAPI
+AptioGetDeviceModel (
+  VOID
+  )
+{
+  EFI_SMBIOS_PROTOCOL      *Smbios;
+  EFI_SMBIOS_HANDLE        Handle;
+  EFI_SMBIOS_TYPE          Type;
+  EFI_SMBIOS_TABLE_HEADER  *Record;
+  SMBIOS_TABLE_TYPE1       *Type1;
+  CONST CHAR8              *Model;
+  CONST CHAR8              *Version;
+  UINTN                    Len;
+
+  if (mDeviceModelRead) {
+    return (mDeviceModel[0] != '\0') ? mDeviceModel : NULL;
+  }
+
+  mDeviceModelRead = TRUE;
+  if (EFI_ERROR (gBS->LocateProtocol (&gEfiSmbiosProtocolGuid, NULL, (VOID **)&Smbios))) {
+    return NULL;
+  }
+
+  Handle = SMBIOS_HANDLE_PI_RESERVED;
+  Type   = EFI_SMBIOS_TYPE_SYSTEM_INFORMATION;
+  if (EFI_ERROR (Smbios->GetNext (Smbios, &Handle, &Type, &Record, NULL))) {
+    return NULL;
+  }
+
+  Type1   = (SMBIOS_TABLE_TYPE1 *)Record;
+  Model   = ChromeSmbiosString (Record, Type1->ProductName);
+  Version = ChromeSmbiosString (Record, Type1->Version);
+
+  //
+  // ThinkPads can report the machine type (for example "20EF...") as the
+  // product name and the model as the version.
+  //
+  if (((Model == NULL) || ((Model[0] >= '0') && (Model[0] <= '9'))) &&
+      (Version != NULL) &&
+      (((Version[0] >= 'A') && (Version[0] <= 'Z')) || ((Version[0] >= 'a') && (Version[0] <= 'z'))))
+  {
+    Model = Version;
+  }
+
+  if (Model == NULL) {
+    return NULL;
+  }
+
+  AsciiStrnCpyS (mDeviceModel, sizeof (mDeviceModel), Model, sizeof (mDeviceModel) - 1);
+  for (Len = AsciiStrLen (mDeviceModel); (Len > 0) && (mDeviceModel[Len - 1] == ' '); Len--) {
+    mDeviceModel[Len - 1] = '\0';
+  }
+
+  return (mDeviceModel[0] != '\0') ? mDeviceModel : NULL;
+}
