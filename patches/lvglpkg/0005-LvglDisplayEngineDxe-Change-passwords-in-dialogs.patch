+/**
+  Click on a password question: ask for the passwords once the event has
+  been handled (see mPendingPassword).
+**/
+STATIC
+VOID
+OnPasswordClicked (
+  lv_event_t  *Event
+  )
+{
+  LVGL_STATEMENT_CONTEXT  *Ctx;
+
+  Ctx = (LVGL_STATEMENT_CONTEXT *)lv_event_get_user_data (Event);
+  if ((Ctx == NULL) || (mPopupOverlay != NULL) || !IsStatementInCurrentForm (Ctx->Statement)) {
+    return;
+  }
+
+  if (lv_obj_has_state (Ctx->Widget, LV_STATE_DISABLED)) {
+    return;
+  }
+
+  mPendingPassword = Ctx->Statement;
+}
