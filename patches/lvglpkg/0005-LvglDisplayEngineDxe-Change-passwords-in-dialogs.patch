+/**
+  ESC cancels the password dialog; ENTER in the field confirms it (the
+  field sends LV_EVENT_READY).
+**/
+STATIC
+VOID
+OnPasswordDialogKey (
+  lv_event_t  *Event
+  )
+{
+  if (lv_indev_get_key (lv_indev_active ()) == LV_KEY_ESC) {
+    mPasswordDialogResult = LVGL_DIALOG_CANCEL;
+    lv_event_stop_processing (Event);
+  }
+}
