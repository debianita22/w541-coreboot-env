+/**
+  Send the keys of the keyboard to Group.
+**/
+STATIC
+VOID
+SetKeypadGroup (
+  IN lv_group_t  *Group
+  )
+{
+  lv_indev_t  *Indev;
+
+  Indev = NULL;
+  while ((Indev = lv_indev_get_next (Indev)) != NULL) {
+    if (lv_indev_get_type (Indev) == LV_INDEV_TYPE_KEYPAD) {
+      lv_indev_set_group (Indev, Group);
+    }
+  }
+}
