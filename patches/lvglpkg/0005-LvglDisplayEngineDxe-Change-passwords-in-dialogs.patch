+/**
+  Change the password of a password question, like the text display
+  engine: an empty password first tells whether the current one is needed,
+  then the new password is asked for twice. When both match, it goes to
+  the browser, which hands it to the driver.
+**/
+STATIC
+VOID
+RunPasswordDialogs (
+  IN FORM_DISPLAY_ENGINE_STATEMENT  *Statement
+  )
+{
+  EFI_IFR_PASSWORD  *PasswordOp;
+  UINTN             MaxChars;
+  UINTN             BufferLen;
+  CHAR16            *Password;
+  CHAR16            *Confirm;
+  UINT8             *Buffer;
+  EFI_STATUS        Status;
+
+  if ((Statement == NULL) || (Statement->PasswordCheck == NULL) ||
+      !IsStatementInCurrentForm (Statement) || (mSession.UserInput == NULL))
+  {
+    return;
+  }
+
+  PasswordOp = (EFI_IFR_PASSWORD *)Statement->OpCode;
+  MaxChars   = PasswordOp->MaxSize;
+  BufferLen  = Statement->CurrentValue.BufferLen;
+  Password   = AllocateZeroPool ((MaxChars + 1) * sizeof (CHAR16));
+  Confirm    = AllocateZeroPool ((MaxChars + 1) * sizeof (CHAR16));
+  if ((Password == NULL) || (Confirm == NULL) || (BufferLen < sizeof (CHAR16))) {
+    goto Done;
+  }
+
+  Status = Statement->PasswordCheck (mSession.FormData, Statement, Password);
+  if ((Status == EFI_NOT_AVAILABLE_YET) || (Status == EFI_UNSUPPORTED)) {
+    if (Status == EFI_UNSUPPORTED) {
+      RunHiiPopup ("Password", "This password cannot be changed.", EfiHiiPopupStyleError, EfiHiiPopupTypeOk);
     }
+
+    goto Done;
   }
 
-  lv_group_delete (PopupGroup);
-  mHiiPopupGroup = NULL;
-  lv_uefi_keypad_drain ();
+  if (EFI_ERROR (Status)) {
+    if (EFI_ERROR (ReadPasswordDialog ("Current Password", "Enter the current password.", Password, MaxChars))) {
+      goto Done;
+    }
 
-  if (UserSelection != NULL) {
-    *UserSelection = (EFI_HII_POPUP_SELECTION)mHiiPopupSel;
+    Status = Statement->PasswordCheck (mSession.FormData, Statement, Password);
+    if (EFI_ERROR (Status)) {
+      if (Status == EFI_NOT_READY) {
+        RunHiiPopup ("Incorrect Password", "The password was not changed.", EfiHiiPopupStyleError, EfiHiiPopupTypeOk);
+      }
+
+      goto Done;
+    }
   }
 
-  FreePool (Utf8);
-  return EFI_SUCCESS;
+  if (EFI_ERROR (ReadPasswordDialog ("New Password", "Enter the new password.", Password, MaxChars)) ||
+      EFI_ERROR (ReadPasswordDialog ("Confirm Password", "Enter the new password again.", Confirm, MaxChars)))
+  {
+    //
+    // Reset the state machine of the driver.
+    //
+    Statement->PasswordCheck (mSession.FormData, Statement, NULL);
+    goto Done;
+  }
+
+  if (StrCmp (Password, Confirm) != 0) {
+    Statement->PasswordCheck (mSession.FormData, Statement, NULL);
+    RunHiiPopup ("Passwords Do Not Match", "The password was not changed.", EfiHiiPopupStyleError, EfiHiiPopupTypeOk);
+    goto Done;
+  }
+
+  Buffer = AllocateZeroPool (BufferLen);
+  if (Buffer == NULL) {
+    Statement->PasswordCheck (mSession.FormData, Statement, NULL);
+    goto Done;
+  }
+
+  //
+  // BufferLen is MaxSize characters, without a terminator: the browser adds
+  // one. A password of MaxSize characters fills it, as with the text engine.
+  //
+  CopyMem (Buffer, Password, MIN (StrLen (Password) * sizeof (CHAR16), BufferLen));
+  mSession.UserInput->SelectedStatement       = Statement;
+  mSession.UserInput->InputValue.Type         = Statement->CurrentValue.Type;
+  mSession.UserInput->InputValue.Buffer       = Buffer;
+  mSession.UserInput->InputValue.BufferLen    = (UINT16)BufferLen;
+  mSession.UserInput->InputValue.Value.string = HiiSetString (mSession.FormData->HiiHandle, 0, Password, NULL);
+  mSession.UserInput->Action                  = 0;
+  mSession.ExitRequested                      = TRUE;
+
+Done:
+  if (Password != NULL) {
+    ZeroMem (Password, (MaxChars + 1) * sizeof (CHAR16));
+    FreePool (Password);
+  }
+
+  if (Confirm != NULL) {
+    ZeroMem (Confirm, (MaxChars + 1) * sizeof (CHAR16));
+    FreePool (Confirm);
+  }
 }
 
 VOID
