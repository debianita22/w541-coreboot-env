diff --git a/LvglDisplayEngineDxe/LvglAptioChrome.c b/LvglDisplayEngineDxe/LvglAptioChrome.c
index 557739b..4edb928 100644
--- a/LvglDisplayEngineDxe/LvglAptioChrome.c
+++ b/LvglDisplayEngineDxe/LvglAptioChrome.c
@@ -9,6 +9,7 @@
 
 #include "LvglAptioChrome.h"
 #include "LvglDesktop.h"
+#include "LvglLogo.h"
 #include <LvglTheme.h>
 #include <Library/BaseLib.h>
 #include <Library/BaseMemoryLib.h>
@@ -497,9 +498,10 @@ ClockTimerCb (
 }
 
 /**
-  Build the menu bar across the top of the screen: settings symbol, setup
-  title and device model on the left; Secure Boot state, USB storage,
-  battery, date and time on the right.
+  Build the menu bar across the top of the screen: the logo, the firmware
+  name (PcdLvglAptioHeaderVendor), the setup title and the device model on
+  the left; Secure Boot state, USB storage, battery, date and time on the
+  right.
 **/
 STATIC
 VOID
@@ -509,6 +511,8 @@ BuildMenuBar (
 {
   lv_obj_t         *Bar;
   lv_obj_t         *Item;
+  lv_obj_t         *Logo;
+  int32_t          Factor;
   CONST lv_font_t  *Font;
   CONST CHAR8      *Model;
   CONST CHAR8      *Vendor;
@@ -533,7 +537,23 @@ BuildMenuBar (
   lv_obj_set_flex_flow (Bar, LV_FLEX_FLOW_ROW);
   lv_obj_set_flex_align (Bar, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
 
-  ChromeLabel (Bar, THEME_HEADER_BADGE_SYMBOL, Font, THEME_COLOR_HEADER_TEXT);
+  //
+  // The logo, pixel art: enlarged by a whole factor only, without
+  // anti-aliasing, so that its pixels stay square.
+  //
+  Logo = lv_image_create (Bar);
+  lv_image_set_src (Logo, &mOuroBiosLogo);
+  lv_image_set_antialias (Logo, false);
+  Factor = THEME_HEADER_LOGO_SIZE / mOuroBiosLogo.header.w;
+  if (Factor > 1) {
+    lv_image_set_scale (Logo, LV_SCALE_NONE * Factor);
+  }
+
+  Vendor = (CONST CHAR8 *)PcdGetPtr (PcdLvglAptioHeaderVendor);
+  if ((Vendor != NULL) && (Vendor[0] != '\0')) {
+    ChromeLabel (Bar, Vendor, Font, THEME_COLOR_HEADER_TEXT);
+  }
+
   ChromeLabel (Bar, (CONST CHAR8 *)PcdGetPtr (PcdLvglAptioHeaderTitle), Font, THEME_COLOR_HEADER_TEXT);
 
   Model = AptioGetDeviceModel ();
@@ -541,11 +561,6 @@ BuildMenuBar (
     ChromeLabel (Bar, Model, Font, THEME_COLOR_HEADER_DIM);
   }
 
-  Vendor = (CONST CHAR8 *)PcdGetPtr (PcdLvglAptioHeaderVendor);
-  if ((Vendor != NULL) && (Vendor[0] != '\0')) {
-    ChromeLabel (Bar, Vendor, Font, THEME_COLOR_HEADER_DIM);
-  }
-
   ChromeSpacer (Bar);
 
   //
