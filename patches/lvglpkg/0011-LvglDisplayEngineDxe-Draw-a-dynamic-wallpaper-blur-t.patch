new file mode 100644
index 0000000..9f42775
--- /dev/null
+++ b/LvglDisplayEngineDxe/LvglDesktop.h
@@ -0,0 +1,49 @@
+/** @file
+  Desktop wallpaper of the setup: drawn, not stored. A sky gradient across
+  the screen and soft orbs of color over it, in a palette that follows the
+  hour of the day, like a dynamic desktop.
+
+  Copyright (c) 2024-2026, Hamit Karaca. All rights reserved.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef LVGL_DESKTOP_H_
+#define LVGL_DESKTOP_H_
+
+#include <Library/LvglLib.h>
+
+/**
+  Draw the wallpaper on a screen, in the palette of the current hour: the
+  screen background becomes the sky gradient and the orbs are its first
+  children, so everything built afterwards sits on top of them.
+
+  @param[in]  Screen  The screen.
+**/
+VOID
+EFIAPI
+DesktopBuild (
+  IN lv_obj_t  *Screen
+  );
+
+/**
+  Switch the wallpaper to the palette of the given hour, if it is not the
+  one shown. Cheap when nothing changes: call it from the clock timer.
+
+  @param[in]  Hour  Hour of the day, 0-23.
+**/
+VOID
+EFIAPI
+DesktopSetHour (
+  IN UINTN  Hour
+  );
+
+/**
+  Forget the wallpaper objects: the screen that holds them is going away.
+**/
+VOID
+EFIAPI
+DesktopTeardown (
+  VOID
+  );
+
+#endif // LVGL_DESKTOP_H_
