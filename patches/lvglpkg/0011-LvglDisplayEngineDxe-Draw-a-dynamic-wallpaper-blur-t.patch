diff --git a/LvglDisplayEngineDxe/LvglDesktop.c b/LvglDisplayEngineDxe/LvglDesktop.c
new file mode 100644
index 0000000..1ca8c9a
--- /dev/null
+++ b/LvglDisplayEngineDxe/LvglDesktop.c
@@ -0,0 +1,244 @@
+/** @file
+  Desktop wallpaper of the setup: drawn, not stored. A vertical sky gradient
+  across the screen and three soft orbs of color over it, each a circle
+  filled with a radial gradient that fades to transparent at its edge, so
+  that they blend into the sky and into each other. The palette follows the
+  hour of the day, like a dynamic desktop: night, dawn, day, dusk and
+  evening. Nothing is animated: the wallpaper only changes when the hour
+  moves into another band, and the objects are only redrawn where the
+  screen is invalidated.
+
+  Copyright (c) 2024-2026, Hamit Karaca. All rights reserved.<BR>
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include "LvglDesktop.h"
+#include <LvglTheme.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+
+//
+// The hour bands of the day and the palette of each.
+//
+typedef enum {
+  DesktopNight,
+  DesktopDawn,
+  DesktopDay,
+  DesktopDusk,
+  DesktopEvening,
+  DesktopPeriodMax
+} DESKTOP_PERIOD;
+
+typedef struct {
+  UINT32  SkyTop;
+  UINT32  SkyBottom;
+  UINT32  Orb[THEME_WALLPAPER_ORBS];
+  UINT8   OrbOpa[THEME_WALLPAPER_ORBS];
+} DESKTOP_PALETTE;
+
+STATIC CONST DESKTOP_PALETTE  mPalettes[DesktopPeriodMax] = {
+  [DesktopNight]   = { 0x05070F, 0x0C1230, { 0x3B2F8C, 0x0E4C6B, 0x5B1E63 }, { 180, 150, 140 } },
+  [DesktopDawn]    = { 0x0E1024, 0x2A1A3A, { 0xC4552A, 0x8C2F5A, 0x3D2B7A }, { 165, 155, 150 } },
+  [DesktopDay]     = { 0x0B1A33, 0x10294A, { 0x1E6FD9, 0x16A3A8, 0x3F3FBF }, { 175, 150, 135 } },
+  [DesktopDusk]    = { 0x121026, 0x3A1D2E, { 0xD9552E, 0xC98A2A, 0x5C2E8A }, { 175, 150, 155 } },
+  [DesktopEvening] = { 0x080A18, 0x141B3A, { 0x5A35B0, 0x1C4FA8, 0x8E2B6B }, { 175, 155, 130 } },
+};
+
+//
+// Where the orbs sit, in percent of the screen: center and radius (of the
+// screen height). They overlap on purpose.
+//
+typedef struct {
+  INT32  CenterXPct;
+  INT32  CenterYPct;
+  INT32  RadiusPct;
+} DESKTOP_ORB_PLACE;
+
+STATIC CONST DESKTOP_ORB_PLACE  mOrbPlaces[THEME_WALLPAPER_ORBS] = {
+  { 18, 24, 58 },
+  { 84, 62, 62 },
+  { 46, 108, 52 },
+};
+
+STATIC lv_obj_t        *mScreen = NULL;
+STATIC lv_obj_t        *mOrbs[THEME_WALLPAPER_ORBS];
+STATIC lv_grad_dsc_t   mOrbGrads[THEME_WALLPAPER_ORBS];
+STATIC DESKTOP_PERIOD  mPeriod  = DesktopPeriodMax;
+
+/**
+  The band of the day an hour falls in.
+**/
+STATIC
+DESKTOP_PERIOD
+DesktopPeriodOfHour (
+  IN UINTN  Hour
+  )
+{
+  if (Hour < 5) {
+    return DesktopNight;
+  } else if (Hour < 8) {
+    return DesktopDawn;
+  } else if (Hour < 17) {
+    return DesktopDay;
+  } else if (Hour < 20) {
+    return DesktopDusk;
+  } else if (Hour < 22) {
+    return DesktopEvening;
+  }
+
+  return DesktopNight;
+}
+
+/**
+  The current hour from the RTC, or the day band when the clock is not
+  readable.
+**/
+STATIC
+UINTN
+DesktopCurrentHour (
+  VOID
+  )
+{
+  EFI_TIME    Time;
+  EFI_STATUS  Status;
+
+  if (gRT == NULL) {
+    return 12;
+  }
+
+  Status = gRT->GetTime (&Time, NULL);
+  if (EFI_ERROR (Status) || (Time.Hour > 23)) {
+    return 12;
+  }
+
+  return Time.Hour;
+}
+
+/**
+  Paint the sky and the orbs in the colors of a palette.
+**/
+STATIC
+VOID
+DesktopApplyPalette (
+  IN CONST DESKTOP_PALETTE  *Palette
+  )
+{
+  UINTN       Index;
+  lv_color_t  Colors[2];
+  lv_opa_t    Opas[2];
+  UINT8       Fracs[2];
+
+  if (mScreen == NULL) {
+    return;
+  }
+
+  lv_obj_set_style_bg_color (mScreen, lv_color_hex (Palette->SkyTop), 0);
+  lv_obj_set_style_bg_grad_color (mScreen, lv_color_hex (Palette->SkyBottom), 0);
+  lv_obj_set_style_bg_grad_dir (mScreen, LV_GRAD_DIR_VER, 0);
+  lv_obj_set_style_bg_opa (mScreen, LV_OPA_COVER, 0);
+
+  for (Index = 0; Index < THEME_WALLPAPER_ORBS; Index++) {
+    if (mOrbs[Index] == NULL) {
+      continue;
+    }
+
+    //
+    // Radial, from the center of the circle, the color fading to nothing
+    // at the edge. The descriptors are static: the style keeps a pointer.
+    //
+    Colors[0] = lv_color_hex (Palette->Orb[Index]);
+    Colors[1] = Colors[0];
+    Opas[0]   = Palette->OrbOpa[Index];
+    Opas[1]   = LV_OPA_TRANSP;
+    Fracs[0]  = 0;
+    Fracs[1]  = 255;
+    lv_grad_init_stops (&mOrbGrads[Index], Colors, Opas, Fracs, 2);
+    lv_grad_radial_init (
+      &mOrbGrads[Index],
+      LV_GRAD_CENTER,
+      LV_GRAD_CENTER,
+      LV_GRAD_RIGHT,
+      LV_GRAD_CENTER,
+      LV_GRAD_EXTEND_PAD
+      );
+    lv_obj_set_style_bg_grad (mOrbs[Index], &mOrbGrads[Index], 0);
+    lv_obj_set_style_bg_opa (mOrbs[Index], LV_OPA_COVER, 0);
+    lv_obj_invalidate (mOrbs[Index]);
+  }
+
+  lv_obj_invalidate (mScreen);
+}
+
+VOID
+EFIAPI
+DesktopBuild (
+  IN lv_obj_t  *Screen
+  )
+{
+  UINTN     Index;
+  int32_t   HorRes;
+  int32_t   VerRes;
+  int32_t   Radius;
+  lv_obj_t  *Orb;
+
+  mScreen = Screen;
+  HorRes  = LV_HOR_RES;
+  VerRes  = LV_VER_RES;
+
+  for (Index = 0; Index < THEME_WALLPAPER_ORBS; Index++) {
+    Radius = (VerRes * mOrbPlaces[Index].RadiusPct) / 100;
+
+    Orb = lv_obj_create (Screen);
+    lv_obj_remove_style_all (Orb);
+    lv_obj_set_size (Orb, 2 * Radius, 2 * Radius);
+    lv_obj_set_pos (
+      Orb,
+      (HorRes * mOrbPlaces[Index].CenterXPct) / 100 - Radius,
+      (VerRes * mOrbPlaces[Index].CenterYPct) / 100 - Radius
+      );
+    lv_obj_set_style_radius (Orb, LV_RADIUS_CIRCLE, 0);
+    lv_obj_clear_flag (Orb, LV_OBJ_FLAG_CLICKABLE);
+    lv_obj_clear_flag (Orb, LV_OBJ_FLAG_SCROLLABLE);
+    lv_obj_add_flag (Orb, LV_OBJ_FLAG_IGNORE_LAYOUT);
+    mOrbs[Index] = Orb;
+  }
+
+  mPeriod = DesktopPeriodOfHour (DesktopCurrentHour ());
+  DesktopApplyPalette (&mPalettes[mPeriod]);
+}
+
+VOID
+EFIAPI
+DesktopSetHour (
+  IN UINTN  Hour
+  )
+{
+  DESKTOP_PERIOD  Period;
+
+  if (mScreen == NULL) {
+    return;
+  }
+
+  Period = DesktopPeriodOfHour (Hour);
+  if (Period == mPeriod) {
+    return;
+  }
+
+  mPeriod = Period;
+  DesktopApplyPalette (&mPalettes[Period]);
+}
+
+VOID
+EFIAPI
+DesktopTeardown (
+  VOID
+  )
+{
+  UINTN  Index;
+
+  mScreen = NULL;
+  for (Index = 0; Index < THEME_WALLPAPER_ORBS; Index++) {
+    mOrbs[Index] = NULL;
+  }
+
+  mPeriod = DesktopPeriodMax;
+}
