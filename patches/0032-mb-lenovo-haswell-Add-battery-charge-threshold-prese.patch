From: Domenico D'Arrigo <DCHEM88@hotmail.it>
Date: Fri, 9 Oct 2026 23:58:41 +0200
Subject: [PATCH 32/37] mb/lenovo/haswell: Add battery charge threshold presets

The charge thresholds are only set by the OS, through the BCCS and BCSS
methods. Add a battery_charge_limit option that writes them to the EC
at the end of ramstage, for both batteries, like those methods do:

- OS controlled (default, as before): the EC registers are left alone.
- Full charge: 0/0, the battery defaults.
- Stop at 80% (start below 75%).
- Stop at 60% (start below 50%).

With a preset, a threshold set from the OS lasts until the next boot.

The writes are ordered so that the EC never sees a start threshold above
the stop one in effect, in case it refuses it: when the start threshold
goes up past the old stop one, the stop threshold is written first.

TEST=Built lenovo/w541.

Co-authored-by: Claude Opus 5.5 <noreply@anthropic.com>
Co-authored-by: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018n3yuWwDLW63F4vdf7ZFTv
---
 src/mainboard/lenovo/haswell/cfr.c           | 16 +++++
 src/mainboard/lenovo/haswell/mainboard.c     | 64 ++++++++++++++++++++
 src/mainboard/lenovo/haswell/setup_options.h |  8 +++
 3 files changed, 88 insertions(+)

diff --git a/src/mainboard/lenovo/haswell/cfr.c b/src/mainboard/lenovo/haswell/cfr.c
index d614c7dc1..9200dae61 100644
--- a/src/mainboard/lenovo/haswell/cfr.c
+++ b/src/mainboard/lenovo/haswell/cfr.c
@@ -60,12 +60,28 @@ static const struct sm_object cooling_policy = SM_DECLARE_ENUM({
 				SM_ENUM_VALUE_END			},
 });
 
+static const struct sm_object battery_charge_limit = SM_DECLARE_ENUM({
+	.opt_name	= "battery_charge_limit",
+	.ui_name	= "Battery charge thresholds",
+	.ui_helptext	= "Thresholds the EC gets at every boot. A lower limit makes the\n"
+			  "battery last longer when the laptop mostly runs on AC.\n"
+			  "OS controlled: keep what the OS sets (TLP, thinkpad_acpi).",
+	.default_value	= BATTERY_CHARGE_LIMIT_OS,
+	.values		= (const struct sm_enum_value[]) {
+				{ "OS controlled",		BATTERY_CHARGE_LIMIT_OS		},
+				{ "Full charge (100%)",		BATTERY_CHARGE_LIMIT_FULL	},
+				{ "Stop at 80% (start 75%)",	BATTERY_CHARGE_LIMIT_80		},
+				{ "Stop at 60% (start 50%)",	BATTERY_CHARGE_LIMIT_60		},
+				SM_ENUM_VALUE_END						},
+});
+
 static struct sm_obj_form system = {
 	.ui_name = "System",
 	.obj_list = (const struct sm_object *[]) {
 		&me_disable,
 		&nmi,
 		&power_on_after_fail,
+		&battery_charge_limit,
 		NULL
 	},
 };
diff --git a/src/mainboard/lenovo/haswell/mainboard.c b/src/mainboard/lenovo/haswell/mainboard.c
index eae723fd7..088256b6d 100644
--- a/src/mainboard/lenovo/haswell/mainboard.c
+++ b/src/mainboard/lenovo/haswell/mainboard.c
@@ -1,12 +1,23 @@
 /* SPDX-License-Identifier: GPL-2.0-or-later */
 
 #include <build.h>
+#include <console/console.h>
 #include <device/device.h>
 #include <drivers/intel/gma/int15.h>
+#include <ec/acpi/ec.h>
 #include <ec/lenovo/h8/h8.h>
+#include <option.h>
 #include <smbios.h>
 #include <string.h>
 
+#include "setup_options.h"
+
+/* Battery charge thresholds in EC RAM, as in thinkpad_bat_thresholds_b0.asl */
+#define EC_BAT0_START_THRESHOLD	0xb0
+#define EC_BAT0_STOP_THRESHOLD	0xb1
+#define EC_BAT1_START_THRESHOLD	0xb2
+#define EC_BAT1_STOP_THRESHOLD	0xb3
+
 const char *smbios_mainboard_bios_version(void)
 {
 	/* Satisfy thinkpad_acpi. */
@@ -23,6 +34,59 @@ static void mainboard_enable(struct device *dev)
 					GMA_INT15_BOOT_DISPLAY_DEFAULT, 0);
 }
 
+/*
+ * The same writes as the BCCS/BCSS methods that the OS uses. The EC is not
+ * asked for a start threshold above the stop one in effect, in case it
+ * refuses it: when the start one goes up past it, the stop one goes first.
+ */
+static void set_battery_thresholds(u8 start_reg, u8 stop_reg, u8 start, u8 stop)
+{
+	const u8 old_stop = ec_read(stop_reg) & 0x7f;
+
+	if (start >= old_stop) {
+		ec_write(stop_reg, stop);
+		ec_write(start_reg, start);
+	} else {
+		ec_write(start_reg, start);
+		ec_write(stop_reg, stop);
+	}
+}
+
+static void set_battery_charge_limit(void)
+{
+	unsigned int start, stop;
+
+	switch (get_uint_option("battery_charge_limit", BATTERY_CHARGE_LIMIT_OS)) {
+	case BATTERY_CHARGE_LIMIT_FULL:
+		/* 0: battery default */
+		start = 0;
+		stop = 0;
+		break;
+	case BATTERY_CHARGE_LIMIT_80:
+		start = 75;
+		stop = 80;
+		break;
+	case BATTERY_CHARGE_LIMIT_60:
+		start = 50;
+		stop = 60;
+		break;
+	default:
+		/* Keep what the OS set */
+		return;
+	}
+
+	printk(BIOS_DEBUG, "EC: battery charge thresholds: start %u%%, stop %u%%\n",
+	       start, stop);
+	set_battery_thresholds(EC_BAT0_START_THRESHOLD, EC_BAT0_STOP_THRESHOLD, start, stop);
+	set_battery_thresholds(EC_BAT1_START_THRESHOLD, EC_BAT1_STOP_THRESHOLD, start, stop);
+}
+
+static void mainboard_final(void *chip_info)
+{
+	set_battery_charge_limit();
+}
+
 struct chip_operations mainboard_ops = {
 	.enable_dev = mainboard_enable,
+	.final = mainboard_final,
 };
diff --git a/src/mainboard/lenovo/haswell/setup_options.h b/src/mainboard/lenovo/haswell/setup_options.h
index e1aac2bf7..dad9173a0 100644
--- a/src/mainboard/lenovo/haswell/setup_options.h
+++ b/src/mainboard/lenovo/haswell/setup_options.h
@@ -9,4 +9,12 @@ enum cooling_policy {
 	COOLING_POLICY_PASSIVE	= 1,	/* throttling before the fan at full speed */
 };
 
+/* Values of the battery_charge_limit option */
+enum battery_charge_limit {
+	BATTERY_CHARGE_LIMIT_OS		= 0,	/* leave the EC thresholds alone */
+	BATTERY_CHARGE_LIMIT_FULL	= 1,	/* battery defaults: charge to 100% */
+	BATTERY_CHARGE_LIMIT_80		= 2,	/* start below 75%, stop at 80% */
+	BATTERY_CHARGE_LIMIT_60		= 3,	/* start below 50%, stop at 60% */
+};
+
 #endif /* MAINBOARD_LENOVO_HASWELL_SETUP_OPTIONS_H */
