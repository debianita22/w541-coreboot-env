# ThinkPad W541, RAM init con mrc.bin (quello della build 24.08 che girava sul
# portatile: con quello della 4.22 la ripresa da S3 si ferma dentro il blob).
# Immagine completa da 12 MiB: IFD, GbE e ME di blobs/ piu' coreboot.
# I file in w541/ li copia tools/build.sh da blobs/ e assets/.
CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_THINKPAD_W541=y
# Mappa del flash: configs/w541.fmd (le regioni scritte a ogni avvio nel
# chip da 8 MiB, coreboot da solo nel chip da 4 MiB: CBFS di 0x3ff000).
# Con un FMDFILE Kconfig non chiede CBFS_SIZE.
CONFIG_FMDFILE="w541/w541.fmd"

# IFD, GbE e ME trattati come nella 4.22: regioni sbloccate, ME leggibile
# dalla CPU, me_cleaner -S (della ME restano solo ROMP e BUP, piu' il bit
# AltMeDisable). I primi 5 MiB escono identici a quelli di
# legacy/coreboot-4.22/coreboot.rom: tools/verify-rom.sh lo controlla.
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="w541/ifd.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="w541/me.bin"
CONFIG_USE_ME_CLEANER=y
CONFIG_ME_CLEANER_ARGS="-S"
CONFIG_HAVE_GBE_BIN=y
CONFIG_GBE_BIN_PATH="w541/gbe.bin"
CONFIG_UNLOCK_FLASH_REGIONS=y
CONFIG_ME_REGION_ALLOW_CPU_READ_ACCESS=y
CONFIG_VALIDATE_INTEL_DESCRIPTOR=y
CONFIG_CHECK_ME=y

# RAM init
CONFIG_HAVE_MRC=y
CONFIG_MRC_FILE="w541/mrc.bin"
CONFIG_HASWELL_HIDE_PEG_FROM_MRC=y
CONFIG_ENABLE_DDR_2X_REFRESH=y
# Memoria azzerata a ogni avvio (non alla ripresa da S3): 1,7 s con 32 GB.
# Si spegne dal menu, Security -> Memory protection (patch 0045-0046).
CONFIG_SECURITY_CLEAR_DRAM_ON_REGULAR_BOOT=y

# CPU, EC, flash e PCIe come la 4.22
CONFIG_ENABLE_VMX=y
CONFIG_SPI_FLASH_NO_FAST_READ=y
CONFIG_H8_SUPPORT_BT_ON_WIFI=y
CONFIG_H8_FLASH_LEDS_ON_DEATH=y
CONFIG_PCIEXP_HOTPLUG=y

# Registro degli eventi nel flash (RW_ELOG di configs/w541.fmd): avvii,
# sorgenti di wake, cadute di alimentazione, reset del watchdog. Si legge
# con elogtool (util/cbfstool di coreboot) o con tools/elog.py.
CONFIG_ELOG=y
# Anche l'entrata in S3 e S5, scritta dal gestore SMI prima di SLP_EN
CONFIG_ELOG_GSMI=y
# I codici POST anche in CMOS (byte 0x70-0x7A: senza tabella delle opzioni
# CMOS sono liberi). Se un avvio o una ripresa da S3 si ferma, l'avvio dopo
# mette nel registro l'ultimo codice e dove era arrivato (un dispositivo, o
# le righe del log di mrc.bin): patch 0039-0042. Le board con l'EC H8 di
# default non hanno codici POST.
# CONFIG_NO_POST is not set
CONFIG_CMOS_POST=y
CONFIG_CMOS_POST_OFFSET=0x70

# I dati di questa macchina dalla VPD (RO_VPD, vuota nelle release, si
# scrive con tools/vpd.py): numero di serie, UUID, Machine Type Model, SKU e
# famiglia nelle tabelle SMBIOS e nel menu, come col BIOS Lenovo (patch
# 0047). Non la versione del BIOS (VPD_SMBIOS_VERSION, attiva nella 4.22):
# una firmware_version scritta una volta resterebbe dopo ogni aggiornamento.
CONFIG_VPD=y
CONFIG_SMBIOS_SERIAL_FROM_VPD=y
CONFIG_SMBIOS_UUID_FROM_VPD=y
CONFIG_SMBIOS_SYSTEM_DATA_FROM_VPD=y
# CONFIG_VPD_SMBIOS_VERSION is not set

# BIOS Lock nel menu (Security -> Flash protection), spento di default:
# acceso, solo l'SMM scrive il flash (variabili UEFI e registro degli
# eventi, patch 0044, e gli aggiornamenti con capsula), flashrom dall'OS
# puo' solo leggere.
CONFIG_BOOTMEDIA_SMM_BWP_RUNTIME_OPTION=y

# Aggiornamento con capsula UEFI (docs/update.md): ESRT con la versione della
# release (DRIVERS_EFI_MAIN_FW_VERSION, la mette tools/build.sh), capsule su
# disco (\EFI\UpdateCapsule dell'ESP) applicate dal payload nello stesso
# avvio, solo se firmate dalla chiave di keys/capsule-signing.pem (patch
# 0048-0051, edk2 0008-0010). La capsula riscrive RW_MRC_CACHE e COREBOOT:
# variabili UEFI, VPD e registro degli eventi restano. Il GUID e' della
# variante: una capsula nri non si applica sulla mrc, e viceversa. Con
# un'altra mappa del flash le capsule si rifiutano (edk2 0008): GUID nuovi.
# Mai capsule piu' vecchie della v1.2.0, la prima che le applica (LSV).
CONFIG_DRIVERS_EFI_FW_INFO=y
CONFIG_DRIVERS_EFI_MAIN_FW_GUID="b774aa46-be0e-4ec1-bb1b-b7c0bf2722aa"
CONFIG_DRIVERS_EFI_MAIN_FW_LSV=0x01020000
CONFIG_DRIVERS_EFI_UPDATE_CAPSULES=y
CONFIG_DRIVERS_EFI_CAPSULE_ON_DISK_SUPPORT=y
# relativo all'albero di EDK2 (payloads/external/edk2/workspace/mrchromebox)
CONFIG_DRIVERS_EFI_CAPSULE_TRUSTED_PUBLIC_CERT="../../../../../w541/capsule-signing.pem"

# Grafica: libgfxinit per l'iGPU, framebuffer limitato al pannello FHD
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
CONFIG_LINEAR_FRAMEBUFFER_MAX_WIDTH=1920
CONFIG_LINEAR_FRAMEBUFFER_MAX_HEIGHT=1080

# VBIOS della K2100M: l'OS lo legge dal metodo _ROM della dGPU
CONFIG_VGA_BIOS_DGPU=y
CONFIG_VGA_BIOS_DGPU_FILE="w541/vbios_10de_11fc_1.rom"
CONFIG_VGA_BIOS_DGPU_ID="10de,11fc"
# Chiave Optimus per il driver NVIDIA di Windows (NVOP 0x10), da
# blobs/opvk.inc: tools/build.sh la copia dove la include il DSDT
CONFIG_LENOVO_HASWELL_NVIDIA_OPVK=y

# Payload: EDK2 di MrChromebox al commit provato in QEMU
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_TAG_OR_REV="b061f7a46bdb482db24a3c1fc8275e1c2a6681b5"
CONFIG_EDK2_BOOTSPLASH_FILE="w541/bootsplash.bmp"
CONFIG_EDK2_BOOT_MANAGER_ESCAPE=y
CONFIG_EDK2_FOLLOW_BGRT_SPEC=y
